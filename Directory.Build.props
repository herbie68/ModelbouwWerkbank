<Project>
  <PropertyGroup>
    <!-- Keep bin/obj rooted at the repository, even when Visual Studio builds a single project -->
    <BaseIntermediateOutputPath>$(MSBuildThisFileDirectory)Builds\Obj\</BaseIntermediateOutputPath>
    <BaseOutputPath>$(MSBuildThisFileDirectory)Builds\</BaseOutputPath>
    <!-- Never treat project-local build artifacts as source files -->
    <DefaultItemExcludes>$(DefaultItemExcludes);$(MSBuildProjectDirectory)\Builds\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="$(MSBuildProjectDirectory)\Builds\**\*.cs" />
    <None Remove="$(MSBuildProjectDirectory)\Builds\**" />
    <Content Remove="$(MSBuildProjectDirectory)\Builds\**" />
    <EmbeddedResource Remove="$(MSBuildProjectDirectory)\Builds\**" />
  </ItemGroup>
</Project>
