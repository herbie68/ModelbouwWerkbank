<UserControl
    x:Class="Modelbouwer.Views.AboutView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
    xmlns:viewmodels="clr-namespace:Modelbouwer.ViewModels"
    d:DataContext="{d:DesignInstance Type=viewmodels:AboutPageViewModel, IsDesignTimeCreatable=False}"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="85" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel
            Grid.Row="0"
            VerticalAlignment="Center"
            Background="{DynamicResource HeaderBackground}">
            <StackPanel Margin="10,0,0,0" Orientation="Horizontal">
                <Image Style="{DynamicResource HeaderIconStyle}" Source="{StaticResource AppLogo}" />
                <TextBlock Style="{DynamicResource HeaderTitle}" Text="{Binding HeaderTitle}" />
            </StackPanel>
            <Canvas>
                <Path Style="{DynamicResource HeadertTitleLine}" />
            </Canvas>
            <TextBlock Style="{DynamicResource HeaderSubTitle}" Text="{Binding HeaderSubtitle}" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="24,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="44" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" HorizontalAlignment="Center" Orientation="Horizontal">
                <Image Source="{StaticResource AppLogo}" Height="92" Stretch="Uniform" />
                <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                    <Image
                        Margin="28,0,0,7" VerticalAlignment="Center"
                        Source="{StaticResource DevLogo}"
                        Height="72"
                        Stretch="Uniform" />
                    <TextBlock
                        Margin="0,8,0,0"
                        HorizontalAlignment="Center"
                        FontSize="16"
                        FontStyle="Italic"
                        FontWeight="DemiBold"
                        Foreground="#034bac"
                        Text="{Binding AppVersion}" />
                </StackPanel>
            </StackPanel>

            <Border Grid.Row="1" Height="3" Margin="0,18,0,16" Background="{DynamicResource HeaderFontBrush}" />

            <TextBlock
                Grid.Row="2"
                MaxWidth="860"
                HorizontalAlignment="Center"
                FontSize="14"
                Foreground="{DynamicResource EntryFontBrush}"
                Text="{Binding Description}"
                TextAlignment="Center"
                TextWrapping="Wrap" />

            <Border Grid.Row="3" Height="3" Margin="0,16,0,14" Background="{DynamicResource HeaderFontBrush}" />

            <TextBlock
                Grid.Row="4"
                Margin="0,0,0,8"
                FontSize="18"
                FontWeight="SemiBold"
                Foreground="{DynamicResource HeaderFontBrush}"
                Text="{Binding ReleaseHistoryTitle}" />

            <syncfusion:SfDataGrid
                x:Name="CommitGrid"
                Grid.Row="5"
                AllowEditing="False"
                AllowFiltering="False"
                AllowResizingColumns="True"
                AllowSorting="True"
                AutoGenerateColumns="False"
                ColumnSizer="Star"
                ItemsSource="{Binding Commits}"
                SelectionChanged="CommitGrid_SelectionChanged">
                <syncfusion:SfDataGrid.Columns>
                    <syncfusion:GridTextColumn
                        x:Name="DateColumn"
                        Width="150"
                        MappingName="DateText" />
                    <syncfusion:GridTextColumn
                        x:Name="AuthorColumn"
                        Width="260"
                        MappingName="Author" />
                    <syncfusion:GridTextColumn
                        x:Name="CommitTextColumn"
                        MappingName="Summary" />
                </syncfusion:SfDataGrid.Columns>
            </syncfusion:SfDataGrid>

            <DockPanel Grid.Row="6" LastChildFill="True">
                <Button
                    Width="120"
                    Height="28"
                    Margin="0,8,12,0"
                    Command="{Binding LoadMoreCommand}"
                    Content="{Binding LoadMoreText}"
                    DockPanel.Dock="Left" />
                <TextBlock
                    Margin="0,8,0,0"
                    VerticalAlignment="Center"
                    FontStyle="Italic"
                    Foreground="Gray"
                    Text="{Binding StatusMessage}" />
            </DockPanel>

            <Border
                Grid.RowSpan="7"
                Background="#66000000"
                Visibility="{Binding IsDetailOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Border
                    Width="720"
                    MaxHeight="520"
                    Padding="18"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="White"
                    BorderBrush="{DynamicResource HeaderFontBrush}"
                    BorderThickness="2">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,10">
                            <TextBlock
                                FontSize="16"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource HeaderFontBrush}"
                                Text="{Binding SelectedCommit.Summary}"
                                TextWrapping="Wrap" />
                            <TextBlock
                                Margin="0,4,0,0"
                                FontStyle="Italic"
                                Foreground="Gray">
                                <Run Text="{Binding SelectedCommit.DateText}" />
                                <Run Text=" - " />
                                <Run Text="{Binding SelectedCommit.Author}" />
                            </TextBlock>
                        </StackPanel>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <TextBox
                                AcceptsReturn="True"
                                BorderThickness="0"
                                FontFamily="Consolas"
                                IsReadOnly="True"
                                Text="{Binding DetailMessage}"
                                TextWrapping="Wrap" />
                        </ScrollViewer>

                        <Button
                            Grid.Row="2"
                            Width="90"
                            Height="28"
                            Margin="0,12,0,0"
                            HorizontalAlignment="Right"
                            Command="{Binding CloseDetailCommand}"
                            Content="{Binding CloseText}" />
                    </Grid>
                </Border>
            </Border>
        </Grid>
    </Grid>
</UserControl>
