<UserControl x:Class="Modelbouwer.Views.StockManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Modelbouwer.Views"
             xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
             xmlns:sfGrid="clr-namespace:Syncfusion.UI.Xaml.Grid;assembly=Syncfusion.SfGrid.WPF"
             xmlns:viewmodels="clr-namespace:Modelbouwer.ViewModels"
             xmlns:helpers="clr-namespace:Modelbouwer.Helpers"
             xmlns:converters="clr-namespace:Modelbouwer.Converters"
             xmlns:controls="clr-namespace:Modelbouwer.Controls"
             xmlns:language="clr-namespace:Modelbouwer.Resources.Languages" d:DataContext="{d:DesignInstance Type=viewmodels:StockManagementPageViewModel}"
             mc:Ignorable="d" >

    <UserControl.Resources>
        <converters:ByteToImageConverter x:Key="ByteToImageConverter" DefaultImage="{StaticResource noimage}" />
        <converters:ByteToImageConverter x:Key="NullOrEmptyImageConverter" />
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <converters:GreaterThanZeroConverter x:Key="GreaterThanZeroConverter" />
        <converters:CaptionSummaryRowConverter x:Key="CaptionSummaryRowConverter" />
        <converters:MappingNameToAlignmentConverter x:Key="MappingNameToAlignmentConverter" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Header -->
            <RowDefinition Height="85" />
            <!-- Spacer -->
            <RowDefinition Height="2" />
            <!-- Toolbar -->
            <RowDefinition Height="40" />
            <!-- DataGrid -->
            <RowDefinition Height="*" />
            <!-- Footer -->
            <RowDefinition Height="25" />
        </Grid.RowDefinitions>

        <!--#region Page header-->
        <StackPanel
            Grid.Row="0"
            VerticalAlignment="Center"
            Background="{DynamicResource HeaderBackground}">
            <StackPanel Orientation="Horizontal" Margin="10,0,0,0">
                <Image
                    Style="{DynamicResource HeaderIconStyle}"
                    Source="{StaticResource inventorycheck}" />
                <TextBlock Style="{DynamicResource HeaderTitle}" Text="{x:Static language:Language.metadataStockHeaderTitel}" />
            </StackPanel>
            <Canvas>
                <Path Style="{DynamicResource HeadertTitleLine}" />
            </Canvas>
            <StackPanel Orientation="Horizontal">
                <TextBlock Style="{DynamicResource HeaderSubTitle}" Text="{x:Static language:Language.metadataStockHeaderSubtitle}" />

                <TextBlock Text="{x:Static language:Language.generalUnsavedChanges}"
                           Visibility="{Binding HasUnsavedChanges, Converter={StaticResource BooleanToVisibilityConverter}}"
                           Style="{DynamicResource TextBlockUnsavedChangesWarning}" />
            </StackPanel>
        </StackPanel>
        <!--#endregion-->

        <!--#region Toolbar section-->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!--#region Action buttons -->
            <StackPanel Orientation="Horizontal" Grid.Column="0">
                <Button
                    Style="{StaticResource ActionBarButtonStyle}"
                    Command="{Binding DataGridSaveSettingsCommand}"
                    ToolTip="{x:Static language:Language.toolbarButtonActionSaveSettings}">
                    <Image Style="{DynamicResource ToolBarSettingsIcon}" />
                </Button>
                <Button
                    Style="{StaticResource ActionBarButtonStyle}"
                    Command="{Binding DataGridResetSettingsCommand}"
                    ToolTip="{x:Static language:Language.toolbarButtonActionResetSettings}">
                    <Image Style="{DynamicResource ToolBarResetSettingsIcon}" />
                </Button>

            </StackPanel>
            <!--#endregion-->

            <!--#region Record Count Section -->
            <TextBlock
                Grid.Column="1"
                Width="Auto"
                Height="23" FontSize="14" FontWeight="Bold"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

                <Run Text="{x:Static language:Language.toolbarVisibleRowLabelStockManagement}" />
                <Run Text=": " />
                <Run
                    FontSize="16"
                    Text="{Binding VisibleItemCount, StringFormat={}{0:N0}}"
                    FontStyle="Italic" />
                <Run Text=" " />
                <Run Text="{x:Static language:Language.toolbarVisibleRowLabelNumberSeperator}" FontWeight="Normal"/>
                <Run Text=" " />
                <Run Text="{Binding TotalItemCount, StringFormat={}{0:N0}, Mode=OneWay}" FontSize="16" FontWeight="Bold" FontStyle="Italic"/>
            </TextBlock>
            <!--#endregion-->

            <!--#region Search field-->
            <!--  Icon  -->
            <Image
                Grid.Column="2"
                Width="20"
                Height="20"
                Margin="5"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Source="{StaticResource search}">
                <Image.Triggers>
                    <EventTrigger RoutedEvent="Image.Loaded">
                        <BeginStoryboard>
                            <Storyboard AutoReverse="True" RepeatBehavior="Forever">
                                <DoubleAnimation
                                    Storyboard.TargetProperty="Opacity"
                                    From="1.0"
                                    To="0.3"
                                    Duration="0:0:1" />
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Image.Triggers>
            </Image>

            <!--  Input field  -->
            <TextBox
                Grid.Column="3"
                Width="250"
                VerticalAlignment="Center"
                Style="{DynamicResource DefaultTextBox}"
                Tag="{x:Static language:Language.SearchGridTag}"
                Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                ToolTip="{x:Static language:Language.SearchGridTooltip}" />

            <!--  Clear button  -->
            <Button
                Grid.Column="4"
                Width="24"
                Height="24"
                Margin="5"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Command="{Binding ClearSearchCommand}"
                Style="{DynamicResource ClearButtonStyle}" />
            <!--#endregion-->
        </Grid>
        <!--#endregion-->

        <!--#region DataGrid section-->
        <syncfusion:SfDataGrid
            x:Name="dataGrid"
            Grid.Row="3"
            Margin="10,5"
            AllowEditing="True"
            AllowGrouping="True"
            AllowDraggingColumns="True"
            AllowResizingColumns="True"
            AllowSorting="True"
            AllowFiltering="True"
            IsGroupDropAreaExpanded="True"
            SelectionMode="Single"
            SelectionUnit="Row"
            ShowColumnWhenGrouped="True"
            GroupDropAreaStyle="{DynamicResource SfDataGridGroupDropAreaStyle1}"
            ShowGroupDropArea="True"
            SortClickAction="SingleClick"
            LiveDataUpdateMode="AllowDataShaping"
            AutoGenerateColumns="False"
            ColumnSizer="Star"
            ItemsSource="{Binding Items}"
            SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
            Loaded="StockManagementDataGrid_Loaded"
            NavigationMode="Cell" AllowTriStateSorting="True">

            <syncfusion:SfDataGrid.Resources>
                <!-- =================== -->
                <!-- Table Summary Style -->
                <!-- =================== -->
                <Style TargetType="syncfusion:GridTableSummaryCell">
                    <Setter Property="Background" Value="#F7F7E6"/>
                    <Setter Property="Foreground" Value="DarkBlue" />
                    <Setter Property="FontSize" Value="13" />
                    <Setter Property="FontStyle" Value="Italic" />
                    <Setter Property="FontWeight" Value="Bold" />
                    <Setter Property="HorizontalContentAlignment" Value="Right" />
                    <Setter Property="Padding" Value="6,2,6,2"/>
                    <Setter Property="BorderThickness" Value="0,2,0,1"/>
                    <Setter Property="BorderBrush" Value="#CFCFCF"/>
                </Style>

                <!-- ===================== -->
                <!-- Caption Summary Style -->
                <!-- ===================== -->
                <Style TargetType="syncfusion:GridCaptionSummaryCell">
                    <Setter Property="Background" Value="#FBFBEA"/>
                    <Setter Property="Foreground" Value="#2F4F6F"/>
                    <Setter Property="FontSize" Value="12"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="Padding" Value="4,2,4,2"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="BorderThickness" Value="0,1,0,0"/>
                    <Setter Property="BorderBrush" Value="#CFCFCF"/>
                </Style>

                <!-- =============== -->
                <!-- Grid Cell Style -->
                <!-- =============== -->
                <Style TargetType="syncfusion:GridCell">
                    <Setter Property="BorderBrush" Value="#EAEAEA"/>
                    <Setter Property="BorderThickness" Value="0,0,1,1"/>
                </Style>

                <!-- ================= -->
                <!-- Header Cell Style -->
                <!-- ================= -->
                <Style TargetType="syncfusion:GridHeaderCellControl">
                    <Setter Property="Background" Value="#324986"/>
                    <Setter Property="Foreground" Value="White" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Setter Property="Height" Value="40" />
                    <Setter Property="VerticalAlignment" Value="Center" />
                    <Setter Property="BorderBrush" Value="#EAEAEA"/>
                    <Setter Property="BorderThickness" Value="0,0,1,1"/>
                </Style>
            </syncfusion:SfDataGrid.Resources>
            <sfGrid:SfDataGrid.AlternatingRowStyleSelector>
                <StyleSelector/>
            </sfGrid:SfDataGrid.AlternatingRowStyleSelector>

            <syncfusion:SfDataGrid.TableSummaryRows>
                <syncfusion:GridTableSummaryRow
                    Position="Top"
                    ShowSummaryInRow="False"
                    Title="{x:Static language:Language.StockManagementDataGridSummaryText}"
                    TitleColumnCount="3">
                    <syncfusion:GridSummaryRow.SummaryColumns>

                        <syncfusion:GridSummaryColumn
                            Name="Value"
                            MappingName="ProductInventoryValue"
                            SummaryType="DoubleAggregate"
                            Format="'{Sum:c}'"/>

                        <syncfusion:GridSummaryColumn
                            Name="VirtualValue"
                            MappingName="ProductVirtualInventoryValue"
                            SummaryType="DoubleAggregate"
                            Format="'{Sum:c}'"/>

                    </syncfusion:GridSummaryRow.SummaryColumns>
                </syncfusion:GridTableSummaryRow>
            </syncfusion:SfDataGrid.TableSummaryRows>

            <syncfusion:SfDataGrid.CaptionSummaryRow>
                <syncfusion:GridSummaryRow
                    Title=" {ColumnName}: {Key}"
                    ShowSummaryInRow="False"
                    TitleColumnCount="5"
                    >
                    <syncfusion:GridSummaryRow.SummaryColumns>
                        <syncfusion:GridSummaryColumn
                            Name="RowValue"
                            Format="'{Sum:c}'"
                            MappingName="ProductInventoryValue"
                            SummaryType="DoubleAggregate"
                            >
                            <syncfusion:GridSummaryColumn.Template>
                                <DataTemplate>
                                    <TextBlock
                                        HorizontalAlignment="Right"
                                        Style="{StaticResource DataGridGroupColumDataHeader}"
                                        Text="{Binding Converter={StaticResource CaptionSummaryRowConverter}, ConverterParameter=ProductInventoryValue}"
                                        />
                                </DataTemplate>
                            </syncfusion:GridSummaryColumn.Template>
                        </syncfusion:GridSummaryColumn>

                        <syncfusion:GridSummaryColumn
                            Name="RowVirtualValue"
                            Format="'{Sum:c}'"
                            MappingName="ProductVirtualInventoryValue"
                            SummaryType="DoubleAggregate"
                            >
                            <syncfusion:GridSummaryColumn.Template>
                                <DataTemplate>
                                    <TextBlock
                                        HorizontalAlignment="Right"
                                        Style="{StaticResource DataGridGroupColumDataHeader}"
                                        Text="{Binding Converter={StaticResource CaptionSummaryRowConverter}, ConverterParameter=ProductVirtualInventoryValue}"
                                        />
                                </DataTemplate>
                            </syncfusion:GridSummaryColumn.Template>
                        </syncfusion:GridSummaryColumn>
                    </syncfusion:GridSummaryRow.SummaryColumns>
                </syncfusion:GridSummaryRow>
            </syncfusion:SfDataGrid.CaptionSummaryRow>

            <syncfusion:SfDataGrid.Columns>
                <syncfusion:GridTextColumn
                    HeaderText="{x:Static language:Language.StockManagementDataGridHeaderProductId}"
                    IsHidden="True"
                    MappingName="ProductId" />

                <syncfusion:GridTextColumn
                    Width="20"
                    AllowFiltering="False"
                    AllowGrouping="True"
                    AllowSorting="False"
                    HeaderText=""
                    MappingName="ShowCellIcon"
                    >
                    <syncfusion:GridTextColumn.CellTemplate>
                        <DataTemplate>
                            <Image>
                                <Image.Style>
                                    <Style TargetType="Image">
                                        <Setter Property="Margin" Value="3" />
                                        <Setter Property="Source" Value="{x:Null}" />
                                        <Setter Property="Visibility" Value="Collapsed" />

                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ProductShortInventory, Converter={StaticResource GreaterThanZeroConverter}}" Value="True">
                                                <Setter Property="Source" Value="{DynamicResource short}" />
                                                <Setter Property="ToolTip" Value="{x:Static language:Language.StockManagementDataGridValueShortWarning}" />
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>

                                            <DataTrigger Binding="{Binding ProductTempShortInventory, Converter={StaticResource GreaterThanZeroConverter}}" Value="True">
                                                <Setter Property="Source" Value="{DynamicResource tempshort}" />
                                                <Setter Property="ToolTip" Value="{x:Static language:Language.StockManagementDataGridValueTempShortWarning}" />
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>

                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding ProductShortInventory}" Value="0" />
                                                    <Condition Binding="{Binding ProductTempShortInventory}" Value="0" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Source" Value="{x:Null}" />
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Image.Style>
                            </Image>
                        </DataTemplate>
                    </syncfusion:GridTextColumn.CellTemplate>
                </syncfusion:GridTextColumn>

                <syncfusion:GridTextColumn
                    MappingName="ProductCode"
                    AllowGrouping="False"
                    AllowSorting="True"
                    HorizontalHeaderContentAlignment="Left"
                    Width="150"
                    HeaderText="{x:Static language:Language.StockManagementDataGridHeaderCode}"
                    AllowEditing="False" />

                <syncfusion:GridTextColumn
                    MappingName="ProductName"
                    AllowGrouping="False"
                    AllowSorting="True"
                    AllowResizing="True"
                    HorizontalHeaderContentAlignment="Left"
                    HeaderText="{x:Static language:Language.StockManagementDataGridHeaderName}"
                    AllowEditing="False" />

                <syncfusion:GridTextColumn
                    MappingName="ProductCategory"
                    AllowGrouping="True"
                    AllowSorting="True"
                    HorizontalHeaderContentAlignment="Left"
                    HeaderText="{x:Static language:Language.StockManagementDataGridHeaderCategory}"
                    AllowEditing="False" />

                <syncfusion:GridTextColumn
                    MappingName="ProductStorageLocation"
                    AllowGrouping="True"
                    AllowSorting="True"
                    HorizontalHeaderContentAlignment="Left"
                    HeaderText="{x:Static language:Language.StockManagementDataGridHeaderLocation}"
                    AllowEditing="False" />

                <syncfusion:GridNumericColumn
                    MappingName="ProductMinimalStock"
                    HeaderText="{x:Static language:Language.StockManagementDataGridHeaderMinimalStock}"
                    AllowEditing="True"
                    AllowFiltering="False"
                    AllowGrouping="False"
                    AllowSorting="True"
                    Width="140"
                    HorizontalHeaderContentAlignment="Right"
                    MinValue="0"
                    NumberDecimalDigits="2" >
                    <syncfusion:GridNumericColumn.CellStyle>
                        <Style TargetType="{x:Type sfGrid:GridCell}">
                            <Setter Property="Background" Value="#E9EBF1" />
                            <Setter Property="BorderBrush" Value="Black"/>
                            <Setter Property="BorderThickness" Value="0,0,.5,.5"/>
                            <Setter Property="ToolTip" Value="{x:Static language:Language.StockManagementDataGridTooltipEditProductMinimalStock}" />

                        </Style>
                    </syncfusion:GridNumericColumn.CellStyle>
                </syncfusion:GridNumericColumn>

                <syncfusion:GridNumericColumn
                    MappingName="ProductPrice"
                    HeaderText="{x:Static language:Language.StockManagementDataGridHeaderPrice}"
                    AllowEditing="False"
                    AllowFiltering="False"
                    AllowGrouping="False"
                    AllowSorting="True"
                    Width="100"
                    HorizontalHeaderContentAlignment="Right"
                    NumberDecimalDigits="2" >
                    <syncfusion:GridNumericColumn.CellStyle>
                        <Style TargetType="{x:Type sfGrid:GridCell}">
                            <Setter Property="Background" Value="#E9EBF1" />
                            <Setter Property="BorderBrush" Value="Black"/>
                            <Setter Property="BorderThickness" Value="0,0,.5,.5"/>
                            <Setter Property="ToolTip" Value="{x:Static language:Language.StockManagementDataGridTooltipEditProductPrice}" />

                        </Style>
                    </syncfusion:GridNumericColumn.CellStyle>
                </syncfusion:GridNumericColumn>

                <syncfusion:GridNumericColumn
                    MappingName="ProductInventory"
                    HeaderText="{x:Static language:Language.StockManagementDataGridHeaderInventoryAmount}"
                    AllowEditing="True"
                    AllowFiltering="False"
                    AllowGrouping="False"
                    AllowSorting="True"
                    HorizontalHeaderContentAlignment="Right"
                    Width="100"
                    NumberDecimalDigits="2" >
                    <syncfusion:GridNumericColumn.CellStyle>
                        <Style TargetType="{x:Type sfGrid:GridCell}">
                            <Setter Property="Background" Value="#E9EBF1" />
                            <Setter Property="BorderBrush" Value="Black"/>
                            <Setter Property="BorderThickness" Value="0,0,.5,.5"/>
                            <Setter Property="ToolTip" Value="{x:Static language:Language.StockManagementDataGridTooltipEditInventoryAmount}" />

                        </Style>
                    </syncfusion:GridNumericColumn.CellStyle>
                </syncfusion:GridNumericColumn>

                <syncfusion:GridNumericColumn
                    MappingName="ProductInventoryValue"
                    HeaderText="{x:Static language:Language.StockManagementDataGridHeaderInventoryValue}"
                    AllowEditing="False"
                    AllowFiltering="False"
                    AllowGrouping="False"
                    AllowSorting="True"
                    HorizontalHeaderContentAlignment="Right"
                    Width="100"
                    NumberDecimalDigits="2"/>

                <syncfusion:GridNumericColumn
                    MappingName="ProductInOrder"
                    HeaderText="{x:Static language:Language.StockManagementDataGridHeaderOrdered}"
                    AllowEditing="False"
                    AllowFiltering="False"
                    AllowGrouping="False"
                    AllowSorting="True"
                    HorizontalHeaderContentAlignment="Right"
                    Width="100"
                    NumberDecimalDigits="2"/>

                <syncfusion:GridNumericColumn
                    MappingName="ProductShortInventory"
                    HeaderText="{x:Static language:Language.StockManagementDataGridHeaderShort}"
                    AllowEditing="False"
                    AllowFiltering="False"
                    AllowGrouping="False"
                    AllowSorting="True"
                    Width="100"
                    HorizontalHeaderContentAlignment="Right"
                    NumberDecimalDigits="2"/>

                <syncfusion:GridNumericColumn
                    MappingName="ProductVirtualInventory"
                    HeaderText="{x:Static language:Language.StockManagementDataGridHeaderVirtualInventoryAmount}"
                    AllowEditing="True"
                    AllowFiltering="False"
                    AllowGrouping="False"
                    AllowSorting="True"
                    HorizontalHeaderContentAlignment="Right"
                    Width="130"
                    NumberDecimalDigits="2" />

                <syncfusion:GridNumericColumn
                    MappingName="ProductVirtualInventoryValue"
                    HeaderText="{x:Static language:Language.StockManagementDataGridHeaderVirtualInventoryValue}"
                    AllowEditing="False"
                    AllowFiltering="False"
                    AllowGrouping="False"
                    AllowSorting="True"
                    HorizontalHeaderContentAlignment="Right"
                    Width="130"
                    NumberDecimalDigits="2"/>

                <syncfusion:GridNumericColumn
                    MappingName="ProductTempShortInventory"
                    IsHidden="True"
                    NumberDecimalDigits="2"/>

            </syncfusion:SfDataGrid.Columns>
        </syncfusion:SfDataGrid>

        <!--#region -->

    </Grid>
</UserControl>
