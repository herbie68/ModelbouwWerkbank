<UserControl
    x:Class="Modelbouwer.Views.WorktypeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hlp="clr-namespace:Modelbouwer.Helpers"
    xmlns:language="clr-namespace:Modelbouwer.Resources.Languages"
    xmlns:local="clr-namespace:Modelbouwer.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
    xmlns:viewmodels="clr-namespace:Modelbouwer.ViewModels"
    xmlns:converters="clr-namespace:Modelbouwer.Converters"
    d:DataContext="{d:DesignInstance Type=viewmodels:WorktypePageViewModel}"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch"
    mc:Ignorable="d">

    <UserControl.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="85" />
            <RowDefinition Height="96" />
            <RowDefinition Height="40" />
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
            <RowDefinition Height="25" />
        </Grid.RowDefinitions>

        <!--#region Page header-->
        <StackPanel
            Grid.Row="0"
            VerticalAlignment="Center"
            Background="{DynamicResource HeaderBackground}">
            <StackPanel Orientation="Horizontal" Margin="10,0,0,0">
                <Image
                    Style="{DynamicResource HeaderIconStyle}"
                    Source="{StaticResource Worktype}" />
                <TextBlock Style="{DynamicResource HeaderTitle}" Text="{x:Static language:Language.metadataWorkTypeHeaderTitel}" />
            </StackPanel>
            <Canvas>
                <Path Style="{DynamicResource HeadertTitleLine}" />
            </Canvas>
            <StackPanel Orientation="Horizontal">
                <TextBlock Style="{DynamicResource HeaderSubTitle}" Text="{x:Static language:Language.metadataWorkTypeHeaderSubtitle}" />

                <TextBlock Text="{x:Static language:Language.generalUnsavedChanges}"
                           Visibility="{Binding HasUnsavedChanges, Converter={StaticResource BooleanToVisibilityConverter}}"
                           Style="{DynamicResource TextBlockUnsavedChangesWarning}" />
            </StackPanel>
        </StackPanel>
        <!--#endregion-->

        <!--#region Detail fields-->
        <Grid
            Grid.Row="1"
            HorizontalAlignment="Left"
            VerticalAlignment="Center">

            <Grid.RowDefinitions>
                <RowDefinition Height="32" />
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  WorkType name  -->
            <Label
                Grid.Column="0"
                Content="{x:Static language:Language.metadataWorkTypeEntryFieldName}"
                Style="{DynamicResource EntryLabel}" />

            <Label
                Grid.Column="1"
                Style="{DynamicResource EntrySemicolon}" />

            <TextBox
                Grid.Column="2"
                Width="250"
                Style="{DynamicResource DefaultTextBox}"
                Tag="{x:Static language:Language.metadataWorkTypeEntryFieldNameTag}"
                Text="{Binding SelectedItem.WorktypeName, TargetNullValue='',Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                ToolTip="{x:Static language:Language.metadataWorkTypeEntryFieldNameTooltip}" />
        </Grid>
        <!--#endregion-->

        <!--#region Toolbar section-->
        <Grid Grid.Row="3"
              Margin="15,2,15,2"
              VerticalAlignment="Center">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="250" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock
                Text="{Binding ImportStatus}"
                Foreground="Gray"
                FontStyle="Italic"
                Margin="5"
                Visibility="{Binding IsImporting, Converter={StaticResource BooleanToVisibilityConverter}}"
                TextWrapping="Wrap"/>

            <!--#region Toolbar-->
            <StackPanel Orientation="Horizontal" Grid.Column="0" Margin="10,2,0,2">
                <Button
                    Style="{StaticResource ActionBarButtonStyle}"
                    Command="{Binding AddWorkTypeCommand}"
                    ToolTip="{x:Static language:Language.toolbarButtonActionNewRoot}">
                    <Image Style="{DynamicResource ToolBarAddRootIcon}" />
                </Button>

                <Button
                    Style="{StaticResource ActionBarButtonStyle}"
                    Command="{Binding AddSubWorkTypeCommand}"
                    ToolTip="{x:Static language:Language.toolbarButtonActionNewSub}">
                    <Image Style="{DynamicResource ToolBarAddSubIcon}" />
                </Button>

                <Button
                    Style="{StaticResource ActionBarButtonStyle}"
                    Command="{Binding DeleteWorkTypeCommand}"
                    ToolTip="{x:Static language:Language.toolbarButtonActionDelete}">
                    <Image Style="{DynamicResource ToolBarDeleteIcon}" />
                </Button>

                <Button
                    Style="{StaticResource ActionBarButtonStyle}"
                    Command="{Binding SaveWorkTypeCommand}"
                    ToolTip="{x:Static language:Language.toolbarButtonActionSave}">
                    <Image Style="{DynamicResource ToolBarSaveIcon}" />
                </Button>

                <Border Style="{StaticResource ActionBarSeparatorStyle}" />

                <Button
                    Style="{StaticResource ActionBarButtonStyle}"
                    Click="ButtonImport"
                    ToolTip="{x:Static language:Language.toolbarButtonActionImport}">
                    <Image Style="{DynamicResource ToolBarImportIcon}" />
                </Button>

                <Button
                    Style="{StaticResource ActionBarButtonStyle}"
                    Click="ButtonCSVExport"
                    ToolTip="{x:Static language:Language.toolbarButtonActionExportCSV}">
                    <Image Style="{DynamicResource ToolBarCSVExportIcon}" />
                </Button>

                <Button
                    Style="{StaticResource ActionBarButtonStyle}"
                    Click="ButtonExcelExport"
                    ToolTip="{x:Static language:Language.toolbarButtonActionExportExcel}">
                    <Image Style="{DynamicResource ToolBarExcelExportIcon}" />
                </Button>

                <Border Style="{StaticResource ActionBarSeparatorStyle}" />

                <Button
                    Style="{StaticResource ActionBarButtonStyle}"
                    Command="{Binding ExpandCommand}"
                    CommandParameter="{Binding ElementName=SfGridTree}"
                    ToolTip="{x:Static language:Language.toolbarButtonActionExpand}">
                    <Image Style="{DynamicResource ToolBarExpandIcon}" />
                </Button>

                <Button
                    Style="{StaticResource ActionBarButtonStyle}"
                    Command="{Binding CollapseCommand}"
                    CommandParameter="{Binding ElementName=SfGridTree}"
                    ToolTip="{x:Static language:Language.toolbarButtonActionCollapse}">
                    <Image Style="{DynamicResource ToolBarCollapseIcon}" />
                </Button>
            </StackPanel>
            <!--#endregion-->

            <!--#region Search field-->
            <!--  Icon  -->
            <Image
                x:Name="FilterIcon"
                Grid.Column="2"
                Width="20"
                Height="20"
                Margin="5"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Source="{StaticResource search}">
                <Image.Triggers>
                    <EventTrigger RoutedEvent="Image.Loaded">
                        <BeginStoryboard>
                            <Storyboard AutoReverse="True" RepeatBehavior="Forever">
                                <DoubleAnimation
                                    Storyboard.TargetProperty="Opacity"
                                    From="1.0"
                                    To="0.3"
                                    Duration="0:0:1" />
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Image.Triggers>
            </Image>

            <!--  Input field  -->
            <TextBox
                Grid.Column="3"
                Width="250"
                VerticalAlignment="Center"
                Style="{DynamicResource DefaultTextBox}"
                Tag="{x:Static language:Language.SearchTreeTag}"
                Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                ToolTip="{x:Static language:Language.SearchTreeTooltip}" />

            <!--  Clear button  -->
            <Button
                Grid.Column="4"
                Width="24"
                Height="24"
                Margin="5"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Command="{Binding ClearSearchCommand}"
                Style="{DynamicResource ClearButtonStyle}" />
            <!--#endregion-->
        </Grid>
        <!--#endregion-->
        <!--#endregion-->

        <!--#region Data grid-->
        <syncfusion:SfTreeGrid
            x:Name="SfGridTree"
            Grid.Row="4"
            Margin="15,3,15,5"
            HorizontalAlignment="Stretch"
            AllowFiltering="True"
            AutoGenerateColumns="False"
            ColumnSizer="Star"
            ItemsSource="{Binding WorkTypeTree}"
            SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
            ChildPropertyName="Children"
            AutoExpandMode="RootNodesExpanded">

            <syncfusion:SfTreeGrid.Columns>
                <syncfusion:TreeGridTextColumn
                    MappingName="WorktypeName"
                    HeaderText="Worktype" />

                <syncfusion:TreeGridTextColumn
                    MappingName="WorktypeId"
                    HeaderText="ID"
                    IsHidden="True" />

                <syncfusion:TreeGridTextColumn
                    MappingName="ParentId"
                    HeaderText="Parent ID"
                    IsHidden="True" />
            </syncfusion:SfTreeGrid.Columns>

        </syncfusion:SfTreeGrid>
        <!--#endregion-->
    </Grid>
</UserControl>
