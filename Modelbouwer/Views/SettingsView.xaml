<UserControl
    x:Class="Modelbouwer.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:converters="clr-namespace:Modelbouwer.Converters"
    xmlns:language="clr-namespace:Modelbouwer.Resources.Languages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="clr-namespace:Modelbouwer.ViewModels"
    d:DataContext="{d:DesignInstance Type=viewmodels:SettingsPageViewModel, IsDesignTimeCreatable=False}"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch"
    mc:Ignorable="d">

    <UserControl.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="85" />
            <RowDefinition Height="40" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="25" />
        </Grid.RowDefinitions>

        <StackPanel
            Grid.Row="0"
            VerticalAlignment="Center"
            Background="{DynamicResource HeaderBackground}">
            <StackPanel Margin="10,0,0,0" Orientation="Horizontal">
                <Image Style="{DynamicResource HeaderIconStyle}" Source="{StaticResource Settings}" />
                <TextBlock Style="{DynamicResource HeaderTitle}" Text="{x:Static language:Language.SettingsHeaderTitle}" />
            </StackPanel>
            <Canvas>
                <Path Style="{DynamicResource HeadertTitleLine}" />
            </Canvas>
            <StackPanel Orientation="Horizontal">
                <TextBlock Style="{DynamicResource HeaderSubTitle}" Text="{x:Static language:Language.SettingsHeaderSubtitle}" />
                <TextBlock
                    Style="{DynamicResource TextBlockUnsavedChangesWarning}"
                    Text="{x:Static language:Language.generalUnsavedChanges}"
                    Visibility="{Binding HasUnsavedChanges, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </StackPanel>
        </StackPanel>

        <StackPanel
            Grid.Row="1"
            Margin="15,2"
            Orientation="Horizontal"
            VerticalAlignment="Center">
            <Button
                Command="{Binding SaveSettingsCommand}"
                Style="{StaticResource ActionBarButtonStyle}"
                ToolTip="{x:Static language:Language.toolbarButtonActionSaveSettings}">
                <Image Style="{DynamicResource ToolBarSaveIcon}" />
            </Button>
            <Button
                Command="{Binding ReloadSettingsCommand}"
                Style="{StaticResource ActionBarButtonStyle}"
                ToolTip="{x:Static language:Language.toolbarButtonActionResetSettings}">
                <Image Style="{DynamicResource ToolBarResetSettingsIcon}" />
            </Button>
            <TextBlock
                Margin="12,0,0,0"
                VerticalAlignment="Center"
                FontStyle="Italic"
                Foreground="Gray"
                Text="{Binding StatusMessage}" />
        </StackPanel>

        <GroupBox Grid.Row="2" Margin="10,6" Width="560" HorizontalAlignment="Left">
            <GroupBox.Header>
                <StackPanel Orientation="Horizontal">
                    <Image Source="{StaticResource Settings}" Style="{DynamicResource ImageHeaderGroup}" />
                    <TextBlock Text="{x:Static language:Language.SettingsRegionalGroupTitle}" Style="{DynamicResource TextBlockBold}" />
                </StackPanel>
            </GroupBox.Header>

            <Grid Margin="8,6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="36" />
                    <RowDefinition Height="36" />
                    <RowDefinition Height="36" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="260" />
                </Grid.ColumnDefinitions>

                <Label Grid.Row="0" Grid.Column="0" Content="{x:Static language:Language.SettingsRegionLabel}" Style="{DynamicResource EntryLabel}" />
                <Label Grid.Row="0" Grid.Column="1" Style="{DynamicResource EntrySemicolon}" />
                <ComboBox
                    Grid.Row="0"
                    Grid.Column="2"
                    Width="240"
                    Height="26"
                    DisplayMemberPath="DisplayName"
                    ItemsSource="{Binding RegionOptions}"
                    SelectedValue="{Binding SelectedRegion, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    SelectedValuePath="Value" />

                <Label Grid.Row="1" Grid.Column="0" Content="{x:Static language:Language.SettingsLanguageLabel}" Style="{DynamicResource EntryLabel}" />
                <Label Grid.Row="1" Grid.Column="1" Style="{DynamicResource EntrySemicolon}" />
                <ComboBox
                    Grid.Row="1"
                    Grid.Column="2"
                    Width="240"
                    Height="26"
                    DisplayMemberPath="DisplayName"
                    ItemsSource="{Binding LanguageOptions}"
                    SelectedValue="{Binding SelectedLanguage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    SelectedValuePath="Value" />

                <Label Grid.Row="2" Grid.Column="0" Content="{x:Static language:Language.SettingsHourRateLabel}" Style="{DynamicResource EntryLabel}" />
                <Label Grid.Row="2" Grid.Column="1" Style="{DynamicResource EntrySemicolon}" />
                <TextBox
                    Grid.Row="2"
                    Grid.Column="2"
                    Width="120"
                    HorizontalContentAlignment="Right"
                    Style="{DynamicResource DefaultTextBox}"
                    Text="{Binding HourRateText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />

                <TextBlock
                    Grid.Row="3"
                    Grid.Column="0"
                    Grid.ColumnSpan="3"
                    Margin="0,10,0,0"
                    Foreground="Gray"
                    Text="{x:Static language:Language.SettingsRestartNotice}"
                    TextWrapping="Wrap" />
            </Grid>
        </GroupBox>
    </Grid>
</UserControl>
