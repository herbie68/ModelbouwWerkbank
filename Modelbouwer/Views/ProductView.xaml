<UserControl
    x:Class="Modelbouwer.Views.ProductView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
    xmlns:language="clr-namespace:Modelbouwer.Resources.Languages"
    xmlns:helpers="clr-namespace:Modelbouwer.Helpers"
    xmlns:converters="clr-namespace:Modelbouwer.Converters"
    xmlns:controls="clr-namespace:Modelbouwer.Controls"
    xmlns:local="clr-namespace:Modelbouwer.Views"
    xmlns:viewmodels="clr-namespace:Modelbouwer.ViewModels"
    d:DataContext="{d:DesignInstance Type=viewmodels:ProductPageViewModel, IsDesignTimeCreatable=False}"
    mc:Ignorable="d">

    <UserControl.Resources>
        <converters:NullToBooleanConverter x:Key="NullToBooleanConverter" />
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <converters:IntToBoolConverter x:Key="IntToBoolConverter" />
        <converters:ByteToImageConverter x:Key="ByteToImageConverter" DefaultImage="{StaticResource noimage}" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- 0. Header -->
            <RowDefinition Height="85" />
            <!-- 1. Detail section -->
            <RowDefinition Height="465" />
            <!-- 2. Spacer -->
            <RowDefinition Height="2" />
            <!-- 3. Toolbar -->
            <RowDefinition Height="40" />
            <!-- 4. DataGrid -->
            <RowDefinition Height="*" />
            <!-- 5. Footer -->
            <RowDefinition Height="25" />
        </Grid.RowDefinitions>

        <!--#region Page header-->
        <StackPanel
            Grid.Row="0"
            VerticalAlignment="Center"
            Background="{DynamicResource HeaderBackground}">
            <StackPanel Orientation="Horizontal" Margin="10,0,0,0">
                <Image
                    Style="{DynamicResource HeaderIconStyle}"
                    Source="{StaticResource product}" />
                <TextBlock Style="{DynamicResource HeaderTitle}" Text="{x:Static language:Language.metadataProductHeaderTitle}" />
            </StackPanel>
            <Canvas>
                <Path Style="{DynamicResource HeadertTitleLine}" />
            </Canvas>
            <StackPanel Orientation="Horizontal">
                <TextBlock Style="{DynamicResource HeaderSubTitle}" Text="{x:Static language:Language.metadataProductHeaderSubtitle}" />

                <TextBlock Text="{x:Static language:Language.generalUnsavedChanges}"
                           Visibility="{Binding HasUnsavedChanges, Converter={StaticResource BooleanToVisibilityConverter}}"
                           Style="{DynamicResource TextBlockUnsavedChangesWarning}" />
            </StackPanel>
        </StackPanel>
        <!--#endregion-->

        <!--#region Details-->
        <syncfusion:TabControlExt
            Name="tabControl"
            Grid.Row="1"
            TabStripPlacement="Bottom" CloseButtonType="Hide"
            TabItemHeaderStyle="Curve"
            Height="Auto"
            Width="Auto">

            <!--#region General product information -->
            <syncfusion:TabItemExt
                Header="{x:Static language:Language.metadataProductTabGeneralTitle}"
                Image="{StaticResource product}"
                ImageWidth="17"
                ImageHeight="17">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="170" />
                    </Grid.ColumnDefinitions>

                    <!--#region Groupboxes -->
                    <StackPanel Margin="5" Grid.Column="0" Orientation="Vertical">
                        <!--#region Product information group -->
                        <GroupBox Opacity="1">
                            <GroupBox.Header>
                                <StackPanel
                                    Background="Transparent"
                                    Orientation="Horizontal">
                                    <Image
                                        Source="{StaticResource product}"
                                        Style="{DynamicResource ImageHeaderGroup}" />
                                    <TextBlock
                                        Style="{DynamicResource TextBlockBold}"
                                        Text="{x:Static language:Language.metadataProductTabGeneralTabItemProductTitle}" />
                                </StackPanel>
                            </GroupBox.Header>

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="25"/>
                                    <RowDefinition Height="30"/>
                                    <RowDefinition Height="25"/>
                                    <RowDefinition Height="30"/>
                                    <RowDefinition Height="25"/>
                                    <RowDefinition Height="30"/>
                                </Grid.RowDefinitions>

                                <!--#region Search name and Brand labels -->
                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="170"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Label
                                        Grid.Column="0"
                                        Content="{x:Static language:Language.metadataProductTabGeneralTabItemProductFieldCode}"
                                        Style="{DynamicResource EntryLabelHorizontal}" />

                                    <Label
                                        Grid.Column="1"
                                        Content="{x:Static language:Language.metadataProductTabGeneralTabItemProductFieldBrand}"
                                        Style="{DynamicResource EntryLabelHorizontal}" />
                                </Grid>
                                <!--#endregion-->

                                <!--#region Search name and Brand input -->
                                <Grid Grid.Row="1" Margin="5 0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="170"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBox
                                        Grid.Column="0"
                                        Margin="5 2 0 2"
                                        Width="150"
                                        Style="{DynamicResource DefaultTextBox}"
                                        Tag="{x:Static language:Language.metadataProductTabGeneralTabItemProductFieldCodeTag}"
                                        Text="{Binding SelectedItem.ProductCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        ToolTip="{x:Static language:Language.metadataProductTabGeneralTabItemProductFieldCodeTooltip}" />

                                    <syncfusion:ComboBoxAdv
                                        Grid.Column="1"
                                        Margin="5 2 0 2"
                                        Width="200"
                                        HorizontalAlignment="Left"
                                        Cursor="Arrow"
                                        DefaultText="{x:Static language:Language.metadataProductTabGeneralTabItemProductFieldBrandTag}"
                                        DisplayMemberPath="BrandName"
                                        ItemsSource="{Binding ProductBrand}"
                                        SelectedValuePath="BrandId"
                                        SelectedValue="{Binding SelectedItem.ProductBrandId, Mode=TwoWay}"
                                        TextSearch.TextPath="BrandName"
                                        ToolTip="{x:Static language:Language.metadataProductTabGeneralTabItemProductFieldBrandTooltip}" />
                                </Grid>
                                <!--#endregion-->

                                <!--#region Product name-->
                                <Label
                                    Grid.Row="2"
                                    Content="{x:Static language:Language.metadataProductTabGeneralTabItemProductFieldName}"
                                    Style="{DynamicResource EntryLabelHorizontal}" />

                                <TextBox
                                    Grid.Row="3"
                                    Margin="5 2 0 2"
                                    MinWidth="600"
                                    Style="{DynamicResource DefaultTextBox}"
                                    Tag="{x:Static language:Language.metadataProductTabGeneralTabItemProductFieldNameTag}"
                                    Text="{Binding SelectedItem.ProductName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    ToolTip="{x:Static language:Language.metadataProductTabGeneralTabItemProductFieldNameTooltip}" />
                                <!--#endregion-->

                                <!--#region Product category-->
                                <Label
                                    Grid.Row="4"
                                    Content="{x:Static language:Language.metadataProductTabGeneralTabItemProductFieldCategory}"
                                    Style="{DynamicResource EntryLabelHorizontal}" />

                                <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="5,2,0,2" VerticalAlignment="Center">
                                    <!-- Show selected category name -->
                                    <TextBox Width="500"
                                             Text="{Binding SelectedCategory.CategoryName, TargetNullValue='(none)'}"
                                             Style="{DynamicResource DefaultTextBox}"
                                             ToolTip="{x:Static language:Language.metadataProductTabGeneralTabItemProductFieldCategoryTooltip}"
                                             IsEnabled="{Binding SelectedItem, Converter={StaticResource NullToBooleanConverter}}" />

                                    <!-- Button to open the picker -->
                                    <Button Content="{x:Static language:Language.metadataProductTabGeneralTabItemProductButtonSearchCategoryLabel}"
                                            ToolTip="{x:Static language:Language.metadataProductTabGeneralTabItemProductButtonSearchCategoryTooltip}"
                                            Margin="5,0,0,0"
                                            Padding="10,2" Style="{StaticResource SearchButtonStyle}"
                                            Command="{Binding OpenCategoryPickerCommand}"
                                            IsEnabled="{Binding SelectedItem, Converter={StaticResource NullToBooleanConverter}}" />
                                </StackPanel>
                                <!--#endregion-->
                            </Grid>
                        </GroupBox>
                        <!--#endregion-->

                        <!--#region Product stock information -->
                        <GroupBox Opacity="1">
                            <GroupBox.Header>
                                <StackPanel
                                    Background="Transparent"
                                    Orientation="Horizontal">
                                    <Image
                                        Source="{StaticResource Storage}"
                                        Style="{DynamicResource ImageHeaderGroup}" />
                                    <TextBlock
                                        Style="{DynamicResource TextBlockBold}"
                                        Text="{x:Static language:Language.metadataProductTabGeneralTabItemStorageTitle}" />
                                </StackPanel>
                            </GroupBox.Header>

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="25"/>
                                    <RowDefinition Height="30"/>
                                    <RowDefinition Height="25"/>
                                    <RowDefinition Height="30"/>
                                </Grid.RowDefinitions>

                                <!--#region Minimal stock, order quantity, dimensions and unit-->
                                <!--#region Minimal stock, order quantity, dimensions and unit Labels-->
                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="155"/>
                                        <ColumnDefinition Width="155"/>
                                        <ColumnDefinition Width="205"/>
                                        <ColumnDefinition Width="205"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Label
                                        Grid.Column="0"
                                        Content="{x:Static language:Language.metadataProductTabGeneralTabItemStorageFieldMinimalStorage}"
                                        Style="{DynamicResource EntryLabelHorizontal}" />

                                    <Label
                                        Grid.Column="1"
                                        Content="{x:Static language:Language.metadataProductTabGeneralTabItemStorageFieldOrderQuantity}"
                                        Style="{DynamicResource EntryLabelHorizontal}" />

                                    <Label
                                        Grid.Column="2"
                                        Content="{x:Static language:Language.metadataProductTabGeneralTabItemStorageFieldUnit}"
                                        Style="{DynamicResource EntryLabelHorizontal}" />

                                    <Label
                                        Grid.Column="3"
                                        Content="{x:Static language:Language.metadataProductTabGeneralTabItemStorageFieldDimensions}"
                                        Style="{DynamicResource EntryLabelHorizontal}" />
                                </Grid>
                                <!--#endregion-->

                                <!--#region Minimal stock, order quantity, dimensions and unit TextBlocks-->
                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="155"/>
                                        <ColumnDefinition Width="155"/>
                                        <ColumnDefinition Width="205"/>
                                        <ColumnDefinition Width="205"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBox
                                        Grid.Column="0"
                                        Margin="5 2 0 2"
                                        Width="150"
                                        Style="{DynamicResource DefaultTextBox}"
                                        Tag="{x:Static language:Language.metadataProductTabGeneralTabItemStorageFieldMinimalStorageTag}"
                                        Text="{Binding SelectedItem.ProductMinimalStock, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        ToolTip="{x:Static language:Language.metadataProductTabGeneralTabItemStorageFieldMinimalStorageTooltip}" />

                                    <TextBox
                                        Grid.Column="1"
                                        Margin="5 2 0 2"
                                        Width="150"
                                        Style="{DynamicResource DefaultTextBox}"
                                        Tag="{x:Static language:Language.metadataProductTabGeneralTabItemStorageFieldOrderQuantityTag}"
                                        Text="{Binding SelectedItem.ProductStandardQuantity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        ToolTip="{x:Static language:Language.metadataProductTabGeneralTabItemStorageFieldOrderQuantityTooltip}" />

                                    <syncfusion:ComboBoxAdv
                                        Grid.Column="2"
                                        Margin="5 2 0 2"
                                        Width="200"
                                        HorizontalAlignment="Left"
                                        Cursor="Arrow"
                                        DefaultText="{x:Static language:Language.metadataProductTabGeneralTabItemStorageFieldUnitTag}"
                                        DisplayMemberPath="UnitName"
                                        ItemsSource="{Binding ProductUnit}"
                                        SelectedValuePath="UnitId"
                                        SelectedValue="{Binding SelectedItem.ProductUnitId, Mode=TwoWay}"
                                        TextSearch.TextPath="UnitName"
                                        ToolTip="{x:Static language:Language.metadataProductTabGeneralTabItemStorageFieldUnitTooltip}" />

                                    <TextBox
                                        Grid.Column="3"
                                        Margin="5 2 0 2"
                                        Width="150"
                                        Style="{DynamicResource DefaultTextBox}"
                                        Tag="{x:Static language:Language.metadataProductTabGeneralTabItemStorageFieldDimensionsTag}"
                                        Text="{Binding SelectedItem.ProductDimensions, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        ToolTip="{x:Static language:Language.metadataProductTabGeneralTabItemStorageFieldMinimalStorageTooltip}" />
                                </Grid>
                                <!--#endregion-->
                                <!--#endregion-->

                                <!--#region Storage location TextBlock and LocationPicker button-->
                                <Label
                                    Grid.Row="2"
                                    Content="{x:Static language:Language.metadataProductTabGeneralTabItemStorageFieldStorageLocation}"
                                    Style="{DynamicResource EntryLabelHorizontal}" />

                                <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="5,2,0,2" VerticalAlignment="Center">
                                    <!-- Show selected Storage location name -->
                                    <TextBox Width="500"
                                             Text="{Binding SelectedStorageLocation.StorageName, TargetNullValue='(none)'}"
                                             Style="{DynamicResource DefaultTextBox}"
                                             ToolTip="{x:Static language:Language.metadataProductTabGeneralTabItemStorageFieldStorageLocationTooltip}"
                                             IsEnabled="{Binding SelectedItem, Converter={StaticResource NullToBooleanConverter}}" />

                                    <!-- Button to open the picker -->
                                    <Button Content="{x:Static language:Language.metadataProductTabGeneralTabItemStorageButtonSearchStorageLocationLabel}"
                                            ToolTip="{x:Static language:Language.metadataProductTabGeneralTabItemStorageButtonSearchStorageLocationTooltip}"
                                            Margin="5,0,0,0"
                                            Padding="10,2" Style="{StaticResource SearchButtonStyle}"
                                            Command="{Binding OpenStorageLocationPickerCommand}"
                                            IsEnabled="{Binding SelectedItem, Converter={StaticResource NullToBooleanConverter}}" />
                                </StackPanel>
                                <!--#endregion-->

                            </Grid>
                        </GroupBox>
                        <!--#endregion-->

                        <!--#region Product in projects -->
                        <GroupBox Opacity="1">
                            <GroupBox.Header>
                                <StackPanel
                                    Background="Transparent"
                                    Orientation="Horizontal">
                                    <Image
                                        Source="{StaticResource Projects}"
                                        Style="{DynamicResource ImageHeaderGroup}" />
                                    <TextBlock
                                        Style="{DynamicResource TextBlockBold}"
                                        Text="{x:Static language:Language.metadataProductTabGeneralTabItemProjectTitle}" />
                                </StackPanel>
                            </GroupBox.Header>

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="25"/>
                                    <RowDefinition Height="30"/>
                                </Grid.RowDefinitions>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="155"/>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!--#region Labels-->
                                <Label
                                    Grid.Column="0"
                                    Content="{x:Static language:Language.metadataProductTabGeneralTabItemProjectFieldCostPrice}"
                                    Style="{DynamicResource EntryLabelHorizontal}" />

                                <Label
                                    Grid.Column="1"
                                    Content="{x:Static language:Language.metadataProductTabGeneralTabItemProjectFieldProjectCosts}"
                                    Style="{DynamicResource EntryLabelHorizontal}" />
                                <!--#endregion-->

                                <!--#region Data Input-->
                                <TextBox
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    Margin="5 2 0 2"
                                    Width="150"
                                    HorizontalAlignment="Left"
                                    HorizontalContentAlignment="Right"
                                    Style="{DynamicResource DefaultTextBox}"
                                    Tag="{x:Static language:Language.metadataProductTabGeneralTabItemProjectFieldCostPriceTag}"
                                    Text="{Binding SelectedItem.ProductPrice, Mode=TwoWay, StringFormat={}{0:N4}, ConverterCulture='nl-NL', UpdateSourceTrigger=PropertyChanged}"
                                    ToolTip="{x:Static language:Language.metadataProductTabGeneralTabItemProjectFieldCostPriceTooltip}" />

                                <CheckBox
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    IsChecked="{Binding SelectedItem.ProductProjectCosts, Converter={StaticResource IntToBoolConverter}}"
                                    />
                                <!--#endregion-->


                            </Grid>
                        </GroupBox>
                        <!--#endregion-->
                    </StackPanel>
                    <!--#endregion-->

                    <!--#region Image and Image toolbar -->
                    <Grid Grid.Column="1" Height="183" VerticalAlignment="Top">
                        <controls:ImageEditor
                            ImageSource="{Binding SelectedItem.ProductImage, Mode=TwoWay}"
                            RotationAngle="{Binding SelectedItem.ProductImageRotationAngle, Mode=TwoWay}"
                            AddImageCommand="{Binding AddImageCommand}"
                            DeleteImageCommand="{Binding DeleteImageCommand}"
                            RotateCommand="{Binding RotateCommand}" />
                    </Grid>
                    <!--#endregion-->
                </Grid>
            </syncfusion:TabItemExt>
            <!--#endregion-->

            <!--#region Additional product information (memo field) -->
            <syncfusion:TabItemExt
                Header="{x:Static language:Language.metadataProductTabMemoTitle}"
                Image="{StaticResource memo}"
                ImageWidth="17"
                ImageHeight="17">

                <!--#region Memo field section -->
                <controls:RtfEditor
                    x:Name="ProjectMemoEditor"
                    Margin="5"
                    RtfText="{Binding SelectedItem.ProductMemo, Mode=TwoWay, UpdateSourceTrigger=Explicit}" />
                <!--#endregion-->
            </syncfusion:TabItemExt>
            <!--#endregion-->

            <!--#region Product suppliers -->
            <syncfusion:TabItemExt
                Header="{x:Static language:Language.metadataProductTabSupplierTitle}"
                Image="{StaticResource supplier}"
                ImageWidth="17"
                ImageHeight="17">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="40" />
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!--#region Detail fields-->
                    <StackPanel Orientation="Vertical" Grid.Row="0" HorizontalAlignment="Left">
                        <GroupBox Opacity="1" Width="590">
                            <GroupBox.Header>
                                <StackPanel
                                    Background="Transparent"
                                    Orientation="Horizontal">
                                    <Image
                                        Source="{StaticResource product}"
                                        Style="{DynamicResource ImageHeaderGroup}" />
                                    <TextBlock
                                        Style="{DynamicResource TextBlockBold}"
                                        Text="{x:Static language:Language.metadataProductTabGeneralTabItemSupplierTitle}" />
                                </StackPanel>
                            </GroupBox.Header>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="55" />
                                    <RowDefinition Height="55" />
                                    <RowDefinition Height="55" />
                                    <RowDefinition Height="55" />
                                </Grid.RowDefinitions>

                                <!--#region Supplier selection-->
                                <Grid Grid.Row="0" >
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="300"/>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Label
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        Content="{x:Static language:Language.metadataProductSupplierTabInfoTabItemSupplierProductLabel}"
                                        Style="{DynamicResource EntryLabelHorizontal}" />

                                    <syncfusion:ComboBoxAdv
                                        Grid.Column="0"
                                        Grid.Row="1"
                                        Margin="5 2 0 2"
                                        Width="200"
                                        HorizontalAlignment="Left" VerticalContentAlignment="Center" VerticalAlignment="Bottom"
                                        Cursor="Arrow"
                                        DefaultText="{x:Static language:Language.metadataProductSupplierTabInfoTabItemSupplierProductTag}"
                                        DisplayMemberPath="Name"
                                        ItemsSource="{Binding AvailableSuppliers}"
                                        SelectedItem="{Binding SelectedSupplierSupplier, Mode=TwoWay}"
                                        TextSearch.TextPath="Name"
                                        Tag="{x:Static language:Language.metadataProductSupplierTabInfoTabItemSupplierProductTag}"
                                        ToolTip="{x:Static language:Language.metadataProductSupplierTabInfoTabItemSupplierProductTooltip}" />

                                    <!--#region Default suplier-->
                                    <Label
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        Content="{x:Static language:Language.metadataProductSupplierTabInfoTabItemSupplierProductDefaultLabel}"
                                        Style="{DynamicResource EntryLabelHorizontal}" />

                                    <CheckBox
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        IsChecked="{Binding SelectedSupplier.DefaultSupplier, Mode=TwoWay}"
                                        />
                                    <!--#endregion-->

                                </Grid>
                                <!--#endregion-->

                                <!--#region Product number supplier, price supplier, Default supplier -->
                                <Grid Grid.Row="1" >
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="410"/>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!--#region Product Number-->
                                    <Label
                                        Grid.Column="0"
                                        Grid.Row="0"
                                        Content="{x:Static language:Language.metadataProductSupplierTabInfoTabItemSupplierProductNumberLabel}"
                                        Style="{DynamicResource EntryLabelHorizontal}" />

                                    <TextBox
                                        Grid.Column="0"
                                        Grid.Row="1"
                                        Margin="5 0 0 0"
                                        MinWidth="390"
                                        Style="{DynamicResource DefaultTextBox}"
                                        Tag="{x:Static language:Language.metadataProductSupplierTabInfoTabItemSupplierProductNumberTag}"
                                        Text="{Binding SelectedSupplier.ProductNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        ToolTip="{x:Static language:Language.metadataProductSupplierTabInfoTabItemSupplierProductNumberTooltip}" />
                                    <!--#endregion-->

                                    <!--#region Product Price-->
                                    <Label
                                        Grid.Column="1" Margin="0 0 5 0"
                                        Grid.Row="0" HorizontalAlignment="Right"
                                        Content="{x:Static language:Language.metadataProductSupplierTabInfoTabItemSupplierProductPriceLabel}"
                                        Style="{DynamicResource EntryLabelHorizontal}" />

                                    <StackPanel Grid.Column="1"
                                                Grid.Row="1"
                                                Orientation="Horizontal"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center">
                                        <Label Margin="2 0 0 0" Width="20" Content="{Binding SelectedSupplier.CurrencySymbol}"/>

                                        <TextBox
                                            Grid.Row="1"
                                            Grid.Column="2"
                                            Margin="0 0 0 0"
                                            Width="120"
                                            HorizontalAlignment="Left"
                                            HorizontalContentAlignment="Right"
                                            Style="{DynamicResource DefaultTextBox}"
                                            Tag="{x:Static language:Language.metadataProductSupplierTabInfoTabItemSupplierProductPriceTag}"
                                            Text="{Binding SelectedSupplier.Price, Mode=TwoWay, StringFormat={}{0:N2}, ConverterCulture='nl-NL', UpdateSourceTrigger=PropertyChanged}"
                                            ToolTip="{x:Static language:Language.metadataProductSupplierTabInfoTabItemSupplierProductPriceTooltip}" />
                                    </StackPanel>
                                    <!--#endregion-->

                                </Grid>
                                <!--#endregion-->

                                <!--#region Product description -->
                                <Grid Grid.Row="2" >
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="20"/>
                                        <RowDefinition Height="30"/>
                                    </Grid.RowDefinitions>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="560"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Label
                                        Grid.Column="0"
                                        Content="{x:Static language:Language.metadataProductSupplierTabInfoTabItemSupplierProductNameLabel}"
                                        Style="{DynamicResource EntryLabelHorizontal}" Margin="5,0,0,0" />

                                    <TextBox
                                        Grid.Column="0"
                                        Grid.Row="1"
                                        Margin="5 0 0 0"
                                        MinWidth="550"
                                        Style="{DynamicResource DefaultTextBox}"
                                        Tag="{x:Static language:Language.metadataProductSupplierTabInfoTabItemSupplierProductNameTag}"
                                        Text="{Binding SelectedSupplier.ProductName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        ToolTip="{x:Static language:Language.metadataProductSupplierTabInfoTabItemSupplierProductNameTooltip}" />

                                </Grid>
                                <!--#endregion-->

                                <!--#region Product website -->
                                <Grid Grid.Row="3" >
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="20"/>
                                        <RowDefinition Height="30"/>
                                    </Grid.RowDefinitions>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="560"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Label
                                        Grid.Column="0"
                                        Grid.Row="0"
                                        Content="{x:Static language:Language.metadataProductSupplierTabInfoTabItemSupplierProductUrlLabel}"
                                        Style="{DynamicResource EntryLabelHorizontal}" />

                                    <StackPanel
                                        Grid.Column="0"
                                        Grid.Row="1"
                                        Margin="0 2 0 2"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center">

                                        <TextBox
                                            Width="518"
                                            Margin="5 0 0 0"
                                            Style="{DynamicResource DefaultTextBox}"
                                            Tag="{x:Static language:Language.metadataProductSupplierTabInfoTabItemSupplierProductUrlTag}"
                                            Text="{Binding SelectedSupplier.URL, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            ToolTip="{x:Static language:Language.metadataProductSupplierTabInfoTabItemSupplierProductUrlTooltip}" />

                                        <Button
                                            x:Name="GotoWeb"
                                            Width="25"
                                            Height="25"
                                            BorderBrush="Transparent"
                                            BorderThickness="0"
                                            Background="Transparent"
                                            Margin="8,0,0,0"
                                            Command="{Binding OpenWebsiteCommand}"
                                            ToolTip="{x:Static language:Language.metadataProductSupplierTabInfoTabItemSupplierProductUrlButtonTooltip}" >
                                            <Border
                                                BorderBrush="DarkBlue"
                                                BorderThickness=".25"
                                                CornerRadius="4"
                                                Padding="2"
                                                Margin="0">
                                                <Image
                                                    IsEnabled="False"
                                                    Style="{DynamicResource GotoWebIcon}"
                                                    />
                                            </Border>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                                <!--#endregion-->
                            </Grid>
                        </GroupBox>
                    </StackPanel>
                    <!--#endregion-->

                    <!--#region Toolbar and datagrid for Suppliers per product-->
                    <StackPanel Orientation="Vertical" Grid.Row="0" Grid.Column="1" HorizontalAlignment="Left">
                        <GroupBox Opacity="1" Width="540">
                            <GroupBox.Header>
                                <StackPanel
                                    Background="Transparent"
                                    Orientation="Horizontal">
                                    <Image
                                        Source="{StaticResource supplier}"
                                        Style="{DynamicResource ImageHeaderGroup}" />
                                    <TextBlock
                                        Style="{DynamicResource TextBlockBold}"
                                        Text="{x:Static language:Language.metadataProductTabGeneralTabItemProductSuppliersTitle}" />
                                    <TextBlock Text="{x:Static language:Language.generalUnsavedChanges}"
                                               Visibility="{Binding HasUnsavedSupplierChanges, Converter={StaticResource BooleanToVisibilityConverter}}"
                                               Style="{DynamicResource TextBlockUnsavedChangesWarning}" />
                                </StackPanel>
                            </GroupBox.Header>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="40" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <!--#region Toolbar section-->
                                <Grid Grid.Row="0"
                                      Margin="15,2,15,2"
                                      VerticalAlignment="Center">

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!--#region Toolbar-->
                                    <StackPanel Orientation="Horizontal" Grid.Column="0" Margin="10,2,0,2">
                                        <Button
                                            Style="{StaticResource ActionBarButtonStyle}"
                                            Command="{Binding DataContext.AddSupplierCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            ToolTip="{x:Static language:Language.toolbarButtonActionNew}">
                                            <Image Style="{DynamicResource ToolBarAddIcon}" />
                                        </Button>

                                        <Button
                                            Style="{StaticResource ActionBarButtonStyle}"
                                            Command="{Binding DataContext.DeleteSupplierCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            ToolTip="{x:Static language:Language.toolbarButtonActionDelete}">
                                            <Image Style="{DynamicResource ToolBarDeleteIcon}" />
                                        </Button>

                                        <Button
                                            Style="{StaticResource ActionBarButtonStyle}"
                                            Command="{Binding DataContext.SaveSupplierCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            ToolTip="{x:Static language:Language.toolbarButtonActionSave}">
                                            <Image Style="{DynamicResource ToolBarSaveIcon}" />
                                        </Button>
                                    </StackPanel>
                                    <!--#endregion-->

                                    <!--#region Record Count Section -->
                                    <TextBlock
                                        Grid.Column="1"
                                        Width="Auto"
                                        Height="23" FontSize="14" FontWeight="Bold"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">

                                        <Run Text="{x:Static language:Language.toolbarVisibleRowLabelProductSupplier}" />
                                        <Run Text=": " />
                                        <Run Text="{Binding TotalSupplierCount, StringFormat={}{0:N0}, Mode=OneWay}" FontSize="16" FontWeight="Bold" FontStyle="Italic"/>
                                    </TextBlock>
                                    <!--#endregion-->
                                </Grid>
                                <!--#endregion-->

                                <!--#region DataGrid-->
                                <syncfusion:SfDataGrid
                                    x:Name="SfSuppliersDataGrid"
                                    Grid.Row="1"
                                    Margin="15,3,15,5"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Top"
                                    AllowDraggingColumns="True"
                                    AllowGrouping="True"
                                    AllowSorting="True"
                                    AllowTriStateSorting="True"
                                    AutoGenerateColumns="False"
                                    ColumnSizer="Star" Height="180"
                                    ItemsSource="{Binding FilteredSuppliers}"
                                    SelectedItem="{Binding SelectedSupplier, Mode=TwoWay}">

                                    <!--#region Columns-->
                                    <syncfusion:SfDataGrid.Columns>
                                        <!--#region hidden columns-->
                                        <syncfusion:GridTextColumn
                                            Width="0"
                                            IsHidden="True"
                                            MappingName="Id" />
                                        <!--#endregion-->

                                        <!--#region Supplier Name-->
                                        <syncfusion:GridTemplateColumn
                                            HeaderText="{x:Static language:Language.metadataSupplierDetailTabContactsDataGridNameHeader}"
                                            MappingName="SupplierName">
                                            <syncfusion:GridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock
                                                        Margin="5 0"
                                                        Text="{Binding SupplierName}" />
                                                </DataTemplate>
                                            </syncfusion:GridTemplateColumn.CellTemplate>
                                        </syncfusion:GridTemplateColumn>
                                        <!--#endregion-->
                                    </syncfusion:SfDataGrid.Columns>
                                    <!--#endregion-->
                                </syncfusion:SfDataGrid>
                                <!--#endregion-->
                            </Grid>
                        </GroupBox>
                    </StackPanel>
                    <!--#endregion-->
                </Grid>
            </syncfusion:TabItemExt>
            <!--#endregion-->

            <!--#region Product Quantity of Stock -->
            <syncfusion:TabItemExt
                Header="{x:Static language:Language.metadataProductTabStockTitle}"
                Image="{StaticResource Storage}"
                ImageWidth="17"
                ImageHeight="17">
                <Grid>

                </Grid>
            </syncfusion:TabItemExt>
            <!--#endregion-->

        </syncfusion:TabControlExt>


        <!--#region Toolbar section-->
        <Grid Grid.Row="3"
              Margin="15,2,15,2"
              VerticalAlignment="Center">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="250" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock
                Text="{Binding ImportStatus}"
                Foreground="Gray"
                FontStyle="Italic"
                Margin="5"
                Visibility="{Binding IsImporting, Converter={StaticResource BooleanToVisibilityConverter}}"
                TextWrapping="Wrap"/>

            <!--#region Toolbar-->
            <StackPanel Orientation="Horizontal" Grid.Column="0" Margin="10,2,0,2">
                <Button
                    Style="{StaticResource ActionBarButtonStyle}"
                    Command="{Binding AddProductCommand}"
                    ToolTip="{x:Static language:Language.toolbarButtonActionNew}">
                    <Image Style="{DynamicResource ToolBarAddIcon}" />
                </Button>

                <Button
                    Style="{StaticResource ActionBarButtonStyle}"
                    Command="{Binding DeleteProductCommand}"
                    ToolTip="{x:Static language:Language.toolbarButtonActionDelete}">
                    <Image Style="{DynamicResource ToolBarDeleteIcon}" />
                </Button>

                <Button
                    Style="{StaticResource ActionBarButtonStyle}"
                    Command="{Binding SaveProductCommand}"
                    ToolTip="{x:Static language:Language.toolbarButtonActionSave}">
                    <Image Style="{DynamicResource ToolBarSaveIcon}" />
                </Button>

                <Border Style="{StaticResource ActionBarSeparatorStyle}" />

                <Button
                    Style="{StaticResource ActionBarButtonStyle}"
                    Click="ButtonImport"
                    ToolTip="{x:Static language:Language.toolbarButtonActionImport}">
                    <Image Style="{DynamicResource ToolBarImportIcon}" />
                </Button>

                <Button
                    Style="{StaticResource ActionBarButtonStyle}"
                    Click="ButtonCSVExport"
                    ToolTip="{x:Static language:Language.toolbarButtonActionExportCSV}">
                    <Image Style="{DynamicResource ToolBarCSVExportIcon}" />
                </Button>

                <Button
                    Style="{StaticResource ActionBarButtonStyle}"
                    Click="ButtonExcelExport"
                    ToolTip="{x:Static language:Language.toolbarButtonActionExportExcel}">
                    <Image Style="{DynamicResource ToolBarExcelExportIcon}" />
                </Button>
            </StackPanel>
            <!--#endregion-->

            <!--#region Record Count Section -->
            <TextBlock
                Grid.Column="1"
                Width="Auto"
                Height="23" FontSize="14" FontWeight="Bold"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

                <Run Text="{x:Static language:Language.toolbarVisibleRowLabelProduct}" />
                <Run Text=": " />
                <Run
                    FontSize="16"
                    Text="{Binding VisibleItemCount, StringFormat={}{0:N0}}"
                    FontStyle="Italic" />
                <Run Text=" " />
                <Run Text="{x:Static language:Language.toolbarVisibleRowLabelNumberSeperator}" FontWeight="Normal"/>
                <Run Text=" " />
                <Run Text="{Binding TotalProductCount, StringFormat={}{0:N0}, Mode=OneWay}" FontSize="16" FontWeight="Bold" FontStyle="Italic"/>
            </TextBlock>
            <!--#endregion-->

            <!--#region Search field-->
            <!--  Icon  -->
            <Image
                Grid.Column="2"
                Width="20"
                Height="20"
                Margin="5"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Source="{StaticResource search}">
                <Image.Triggers>
                    <EventTrigger RoutedEvent="Image.Loaded">
                        <BeginStoryboard>
                            <Storyboard AutoReverse="True" RepeatBehavior="Forever">
                                <DoubleAnimation
                                    Storyboard.TargetProperty="Opacity"
                                    From="1.0"
                                    To="0.3"
                                    Duration="0:0:1" />
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Image.Triggers>
            </Image>

            <!--  Input field  -->
            <TextBox
                Grid.Column="3"
                Width="250"
                VerticalAlignment="Center"
                Style="{DynamicResource DefaultTextBox}"
                Tag="{x:Static language:Language.SearchGridTag}"
                Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                ToolTip="{x:Static language:Language.SearchGridTooltip}" />

            <!--  Clear button  -->
            <Button
                Grid.Column="4"
                Width="24"
                Height="24"
                Margin="5"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Command="{Binding ClearSearchCommand}"
                Style="{DynamicResource ClearButtonStyle}" />
            <!--#endregion-->
        </Grid>
        <!--#endregion-->

        <!--#region Datagrid-->
        <syncfusion:SfDataGrid
            x:Name="SfDataGrid"
            Grid.Row="4"
            Margin="15,3,15,5"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Top"
            AllowDraggingColumns="True"
            AllowGrouping="True"
            AllowSorting="True"
            AllowTriStateSorting="True"
            ScrollViewer.CanContentScroll="True"
            VirtualizingPanel.ScrollUnit="Item"
            AutoGenerateColumns="False"
            ColumnSizer="Star"
            ItemsSource="{Binding Products}"
            Loaded="ProductDataGrid_Loaded"
            SelectedItem="{Binding SelectedItem, Mode=TwoWay}">

            <syncfusion:SfDataGrid.Columns>
                <!--#region hidden columns-->
                <syncfusion:GridTextColumn
                    Width="0"
                    IsHidden="True"
                    MappingName="Id" />
                <!--#endregion-->

                <!--#region Product Code-->
                <syncfusion:GridTemplateColumn
                    Width="150"
                    HeaderText="{x:Static language:Language.metadataProductDataGridProductCodeHeader}"
                    MappingName="Code">
                    <syncfusion:GridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock
                                Margin="5 0"
                                helpers:TextBlockHelper.HighlightText="{Binding DataContext.SearchText, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                Text="{Binding ProductCode}" />
                        </DataTemplate>
                    </syncfusion:GridTemplateColumn.CellTemplate>
                </syncfusion:GridTemplateColumn>
                <!--#endregion-->

                <!--#region Product Name-->
                <syncfusion:GridTemplateColumn
                    HeaderText="{x:Static language:Language.metadataProductDataGridProductNameHeader}"
                    MappingName="Name">
                    <syncfusion:GridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock
                                Margin="5 0"
                                helpers:TextBlockHelper.HighlightText="{Binding DataContext.SearchText, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                Text="{Binding Name}" />
                        </DataTemplate>
                    </syncfusion:GridTemplateColumn.CellTemplate>
                </syncfusion:GridTemplateColumn>
                <!--#endregion-->
            </syncfusion:SfDataGrid.Columns>
        </syncfusion:SfDataGrid>
        <!--#endregion-->
    </Grid>
</UserControl>
