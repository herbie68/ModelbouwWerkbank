<Window x:Class="Modelbouwer.Views.StockReceiptDateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:language="clr-namespace:Modelbouwer.Resources.Languages"
        Title="{x:Static language:Language.StockReceiptDialogTitle}"
        Width="360"
        Height="150"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,16">
            <TextBlock Width="130" VerticalAlignment="Center" Text="{x:Static language:Language.StockReceiptDeliveryDateLabel}" />
            <DatePicker SelectedDate="{Binding DeliveryDate, Mode=TwoWay}" />
        </DockPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button
                Style="{StaticResource ActionBarButtonStyle}"
                Click="SaveClick"
                IsDefault="True"
                ToolTip="{x:Static language:Language.toolbarButtonActionSave}">
                <Image Style="{DynamicResource ToolBarSaveIcon}" />
            </Button>
            <Button
                Style="{StaticResource ActionBarButtonStyle}"
                IsCancel="True"
                ToolTip="{x:Static language:Language.toolbarButtonActionCancel}">
                <Image Style="{DynamicResource ToolBarCancelIcon}" />
            </Button>
        </StackPanel>
    </Grid>
</Window>
