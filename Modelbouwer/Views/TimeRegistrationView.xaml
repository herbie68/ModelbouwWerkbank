<UserControl x:Class="Modelbouwer.Views.TimeRegistrationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
             xmlns:viewmodels="clr-namespace:Modelbouwer.ViewModels"
             xmlns:converters="clr-namespace:Modelbouwer.Converters"
             d:DataContext="{d:DesignInstance Type=viewmodels:TimeRegistrationViewModel, IsDesignTimeCreatable=False}"
             mc:Ignorable="d">

    <UserControl.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <Style x:Key="HourCostToggleStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="74" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid>
                            <Border x:Name="Track"
                                    CornerRadius="14"
                                    Background="#C7CEDA"
                                    BorderBrush="#7C8797"
                                    BorderThickness="1" />
                            <Ellipse x:Name="Thumb"
                                     Width="22"
                                     Height="22"
                                     Margin="4,0,0,0"
                                     HorizontalAlignment="Left"
                                     VerticalAlignment="Center"
                                     Fill="White"
                                     Stroke="#7C8797"
                                     StrokeThickness="1" />
                            <TextBlock x:Name="OffText"
                                       Margin="30,0,8,0"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Right"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Foreground="#2F3B4A"
                                       Text="Nee" />
                            <TextBlock x:Name="OnText"
                                       Margin="8,0,30,0"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Left"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Foreground="White"
                                       Visibility="Collapsed"
                                       Text="Ja" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#2E7D5B" />
                                <Setter TargetName="Track" Property="BorderBrush" Value="#1F5D44" />
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="Thumb" Property="Margin" Value="0,0,4,0" />
                                <Setter TargetName="OffText" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="OnText" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="85" />
            <RowDefinition Height="92" />
            <RowDefinition Height="*" />
            <RowDefinition Height="25" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0"
                    VerticalAlignment="Center"
                    Background="{DynamicResource HeaderBackground}">
            <StackPanel Orientation="Horizontal" Margin="10,0,0,0">
                <Image Style="{DynamicResource HeaderIconStyle}" Source="{StaticResource Time}" />
                <TextBlock Style="{DynamicResource HeaderTitle}" Text="Tijd en materiaal" />
            </StackPanel>
            <Canvas>
                <Path Style="{DynamicResource HeadertTitleLine}" />
            </Canvas>
            <StackPanel Orientation="Horizontal">
                <TextBlock Style="{DynamicResource HeaderSubTitle}" Text="Registreer gewerkte uren, gebruikte materialen en projectkosten" />
                <TextBlock Text="{x:Static language:Language.generalUnsavedChanges}"
                           xmlns:language="clr-namespace:Modelbouwer.Resources.Languages"
                           Visibility="{Binding HasUnsavedTimeChanges, Converter={StaticResource BooleanToVisibilityConverter}}"
                           Style="{DynamicResource TextBlockUnsavedChangesWarning}" />
            </StackPanel>
        </StackPanel>

        <GroupBox Grid.Row="1" Margin="10,6">
            <GroupBox.Header>
                <StackPanel Orientation="Horizontal">
                    <Image Source="{StaticResource Projects}" Style="{DynamicResource ImageHeaderGroup}" />
                    <TextBlock Text="Project" Style="{DynamicResource TextBlockBold}" />
                </StackPanel>
            </GroupBox.Header>
            <Grid Margin="6,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="360" />
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Label Grid.Column="0"
                       VerticalAlignment="Center"
                       Content="Selecteer project"
                       Style="{DynamicResource EntryLabelHorizontal}" />
                <syncfusion:ComboBoxAdv Grid.Column="1"
                                        Height="28"
                                        VerticalAlignment="Center"
                                        AutoCompleteMode="Suggest"
                                        DefaultText="Kies een project"
                                        DisplayMemberPath="ProjectName"
                                        ItemsSource="{Binding Projects}"
                                        SelectedItem="{Binding SelectedProject, Mode=TwoWay}"
                                        SelectedValuePath="ProjectId"
                                        TextSearch.TextPath="ProjectName" />
                <Button Grid.Column="2"
                        Width="28"
                        Height="28"
                        Command="{Binding RefreshCommand}"
                        Style="{StaticResource ActionBarButtonStyle}"
                        ToolTip="Vernieuwen">
                    <Image Style="{DynamicResource ToolBarResetSettingsIcon}" />
                </Button>
                <TextBlock Grid.Column="3"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right"
                           Margin="10,0"
                           FontWeight="SemiBold">
                    <Run Text="Uren: " />
                    <Run Text="{Binding TotalWorkedHours, Mode=OneWay, StringFormat={}{0:N2}}" />
                    <Run Text="   Materialen: " />
                    <Run Text="{Binding MaterialCosts, Mode=OneWay, StringFormat={}{0:C2}}" />
                    <Run Text="   Totaal: " />
                    <Run Text="{Binding ProjectTotalCosts, Mode=OneWay, StringFormat={}{0:C2}}" />
                </TextBlock>
            </Grid>
        </GroupBox>

        <syncfusion:TabControlExt Grid.Row="2"
                                  Margin="10,4,10,8"
                                  TabStripPlacement="Bottom"
                                  CloseButtonType="Hide"
                                  TabItemHeaderStyle="Curve">

            <syncfusion:TabItemExt Header="Tijdregistratie"
                                   Image="{StaticResource Time}"
                                   ImageWidth="17"
                                   ImageHeight="17">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="76" />
                        <RowDefinition Height="40" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <GroupBox Grid.Row="0" Margin="2">
                        <GroupBox.Header>
                            <StackPanel Orientation="Horizontal">
                                <Image Source="{StaticResource Time}" Style="{DynamicResource ImageHeaderGroup}" />
                                <TextBlock Text="Nieuwe urenregel" Style="{DynamicResource TextBlockBold}" />
                            </StackPanel>
                        </GroupBox.Header>
                        <Grid Margin="6,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="230" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="40" />
                            </Grid.ColumnDefinitions>
                            <DatePicker Grid.Column="0"
                                        Width="120"
                                        SelectedDate="{Binding SelectedWorkDate, Mode=TwoWay}" />
                            <TextBox Grid.Column="1"
                                     Width="86"
                                     Style="{DynamicResource DefaultTextBox}"
                                     Tag="Start"
                                     Text="{Binding StartTime, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBox Grid.Column="2"
                                     Width="86"
                                     Style="{DynamicResource DefaultTextBox}"
                                     Tag="Einde"
                                     Text="{Binding EndTime, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <syncfusion:ComboBoxAdv Grid.Column="3"
                                                    Width="220"
                                                    AutoCompleteMode="Suggest"
                                                    DefaultText="Uursoort"
                                                    DisplayMemberPath="WorktypeName"
                                                    ItemsSource="{Binding Worktypes}"
                                                    SelectedItem="{Binding SelectedWorktype, Mode=TwoWay}" />
                            <TextBox Grid.Column="4"
                                     MinWidth="220"
                                     Style="{DynamicResource DefaultTextBox}"
                                     Tag="Opmerking"
                                     Text="{Binding TimeComment, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Grid.Column="5"
                                    Width="30"
                                    Height="28"
                                    Command="{Binding AddTimeEntryCommand}"
                                    Style="{StaticResource ActionBarButtonStyle}"
                                    ToolTip="Urenregel toevoegen">
                                <Image Style="{DynamicResource ToolBarAddIcon}" />
                            </Button>
                        </Grid>
                    </GroupBox>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,3">
                        <Button Width="30"
                                Height="28"
                                Command="{Binding SaveTimeEntriesCommand}"
                                Style="{StaticResource ActionBarButtonStyle}"
                                ToolTip="Uren opslaan">
                            <Image Style="{DynamicResource ToolBarSaveIcon}" />
                        </Button>
                        <TextBlock Margin="10,0"
                                   VerticalAlignment="Center"
                                   FontWeight="SemiBold"
                                   Text="{Binding TimeEntryCount, StringFormat=Regels: {0:N0}}" />
                    </StackPanel>

                    <syncfusion:SfDataGrid Grid.Row="2"
                                           Margin="0,4"
                                           AllowEditing="True"
                                           AllowFiltering="True"
                                           AllowGrouping="True"
                                           AllowResizingColumns="True"
                                           AllowSorting="True"
                                           AutoGenerateColumns="False"
                                           ColumnSizer="Star"
                                           ItemsSource="{Binding TimeEntries}"
                                           SelectionMode="Single"
                                           ShowGroupDropArea="True">
                        <syncfusion:SfDataGrid.Columns>
                            <syncfusion:GridTextColumn Width="36" MappingName="StatusMarker" HeaderText="" AllowEditing="False" />
                            <syncfusion:GridDateTimeColumn Width="110" MappingName="WorkDate" HeaderText="Datum" Pattern="ShortDate" />
                            <syncfusion:GridTextColumn Width="90" MappingName="StartTime" HeaderText="Start" />
                            <syncfusion:GridTextColumn Width="90" MappingName="EndTime" HeaderText="Einde" />
                            <syncfusion:GridTextColumn Width="110" MappingName="WorkedTime" HeaderText="Gewerkt" AllowEditing="False" HorizontalHeaderContentAlignment="Right" TextAlignment="Right" />
                            <syncfusion:GridTextColumn Width="220" MappingName="WorktypeName" HeaderText="Uursoort" AllowEditing="False" />
                            <syncfusion:GridTextColumn Width="260" MappingName="Comment" HeaderText="Opmerking" />
                        </syncfusion:SfDataGrid.Columns>
                    </syncfusion:SfDataGrid>
                </Grid>
            </syncfusion:TabItemExt>

            <syncfusion:TabItemExt Header="Materiaalregistratie"
                                   Image="{StaticResource product}"
                                   ImageWidth="17"
                                   ImageHeight="17">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="76" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <GroupBox Grid.Row="0" Margin="2">
                        <GroupBox.Header>
                            <StackPanel Orientation="Horizontal">
                                <Image Source="{StaticResource product}" Style="{DynamicResource ImageHeaderGroup}" />
                                <TextBlock Text="Nieuw materiaalgebruik" Style="{DynamicResource TextBlockBold}" />
                            </StackPanel>
                        </GroupBox.Header>
                        <Grid Margin="6,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="360" />
                                <ColumnDefinition Width="95" />
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="40" />
                            </Grid.ColumnDefinitions>
                            <syncfusion:ComboBoxAdv Grid.Column="0"
                                                    Width="350"
                                                    AutoCompleteMode="Suggest"
                                                    DefaultText="Product"
                                                    DisplayMemberPath="ProductName"
                                                    ItemsSource="{Binding Products}"
                                                    SelectedItem="{Binding SelectedProduct, Mode=TwoWay}" />
                            <TextBox Grid.Column="1"
                                     Width="82"
                                     HorizontalContentAlignment="Right"
                                     Style="{DynamicResource DefaultTextBox}"
                                     Tag="Aantal"
                                     Text="{Binding MaterialAmount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <DatePicker Grid.Column="2"
                                        Width="120"
                                        SelectedDate="{Binding MaterialUsageDate, Mode=TwoWay}" />
                            <TextBox Grid.Column="3"
                                     MinWidth="220"
                                     Style="{DynamicResource DefaultTextBox}"
                                     Tag="Opmerking"
                                     Text="{Binding MaterialComment, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Grid.Column="4"
                                    Width="30"
                                    Height="28"
                                    Command="{Binding AddMaterialUsageCommand}"
                                    Style="{StaticResource ActionBarButtonStyle}"
                                    ToolTip="Materiaal registreren">
                                <Image Style="{DynamicResource ToolBarAddIcon}" />
                            </Button>
                        </Grid>
                    </GroupBox>

                    <syncfusion:SfDataGrid Grid.Row="1"
                                           Margin="0,4"
                                           AllowEditing="False"
                                           AllowFiltering="True"
                                           AllowGrouping="True"
                                           AllowResizingColumns="True"
                                           AllowSorting="True"
                                           AutoGenerateColumns="False"
                                           ColumnSizer="Star"
                                           ItemsSource="{Binding MaterialUsages}"
                                           SelectionMode="Single"
                                           ShowGroupDropArea="True">
                        <syncfusion:SfDataGrid.Columns>
                            <syncfusion:GridTextColumn Width="240" MappingName="ProductName" HeaderText="Artikel" />
                            <syncfusion:GridTextColumn Width="180" MappingName="CategoryName" HeaderText="Categorie" />
                            <syncfusion:GridNumericColumn Width="95" MappingName="Amount" HeaderText="Aantal" NumberDecimalDigits="2" HorizontalHeaderContentAlignment="Right" />
                            <syncfusion:GridNumericColumn Width="100" MappingName="Price" HeaderText="Prijs" NumberDecimalDigits="2" HorizontalHeaderContentAlignment="Right" />
                            <syncfusion:GridNumericColumn Width="110" MappingName="Costs" HeaderText="Kosten" NumberDecimalDigits="2" HorizontalHeaderContentAlignment="Right" />
                            <syncfusion:GridDateTimeColumn Width="110" MappingName="UsageDate" HeaderText="Datum" Pattern="ShortDate" />
                            <syncfusion:GridTextColumn Width="240" MappingName="Comment" HeaderText="Opmerking" />
                        </syncfusion:SfDataGrid.Columns>
                    </syncfusion:SfDataGrid>
                </Grid>
            </syncfusion:TabItemExt>

            <syncfusion:TabItemExt Header="Projectkosten"
                                   Image="{StaticResource inventorycheck}"
                                   ImageWidth="17"
                                   ImageHeight="17">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="58" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="42" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Margin="6,0,10,0"
                                   VerticalAlignment="Center"
                                   FontWeight="SemiBold"
                                   Text="Uren meerekenen" />
                        <ToggleButton Style="{StaticResource HourCostToggleStyle}"
                                      IsChecked="{Binding IncludeHoursInCosts, Mode=TwoWay}" />
                        <TextBlock Margin="18,0,0,0"
                                   VerticalAlignment="Center">
                            <Run Text="Uurtarief: " />
                            <Run Text="{Binding HourRate, Mode=OneWay, StringFormat={}{0:C2}}" />
                        </TextBlock>
                    </StackPanel>

                    <syncfusion:SfDataGrid Grid.Row="1"
                                           Margin="0,4"
                                           AllowEditing="False"
                                           AllowFiltering="True"
                                           AllowGrouping="True"
                                           AllowResizingColumns="True"
                                           AllowSorting="True"
                                           AutoGenerateColumns="False"
                                           ColumnSizer="Star"
                                           ItemsSource="{Binding CostLines}"
                                           ShowGroupDropArea="True">
                        <syncfusion:SfDataGrid.Columns>
                            <syncfusion:GridTextColumn Width="180" MappingName="GroupName" HeaderText="Groep" />
                            <syncfusion:GridTextColumn Width="320" MappingName="Description" HeaderText="Omschrijving" />
                            <syncfusion:GridNumericColumn Width="110" MappingName="Amount" HeaderText="Aantal/uren" NumberDecimalDigits="2" HorizontalHeaderContentAlignment="Right" />
                            <syncfusion:GridNumericColumn Width="110" MappingName="UnitPrice" HeaderText="Tarief/prijs" NumberDecimalDigits="2" HorizontalHeaderContentAlignment="Right" />
                            <syncfusion:GridNumericColumn Width="130" MappingName="TotalCosts" HeaderText="Totaal" NumberDecimalDigits="2" HorizontalHeaderContentAlignment="Right" />
                        </syncfusion:SfDataGrid.Columns>
                    </syncfusion:SfDataGrid>

                    <TextBlock Grid.Row="2"
                               Margin="6,0"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               FontSize="16"
                               FontWeight="Bold">
                        <Run Text="Projecttotaal: " />
                        <Run Text="{Binding ProjectTotalCosts, Mode=OneWay, StringFormat={}{0:C2}}" />
                    </TextBlock>
                </Grid>
            </syncfusion:TabItemExt>
        </syncfusion:TabControlExt>
    </Grid>
</UserControl>
