<UserControl
    x:Class="Modelbouwer.Views.CountryView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hlp="clr-namespace:Modelbouwer.Helpers"
    xmlns:language="clr-namespace:Modelbouwer.Resources.Languages"
    xmlns:local="clr-namespace:Modelbouwer.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
    xmlns:viewmodels="clr-namespace:Modelbouwer.ViewModels"
    d:DataContext="{d:DesignInstance Type=viewmodels:CountryPageViewModel}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <UserControl.DataContext>
        <viewmodels:CountryPageViewModel />
    </UserControl.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="85" />
            <RowDefinition Height="96" />
            <RowDefinition Height="40" />
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
            <RowDefinition Height="25" />
        </Grid.RowDefinitions>

        <!--#region Page header-->
        <StackPanel
            Grid.Row="0"
            VerticalAlignment="Center"
            Background="{DynamicResource HeaderBackground}">
            <TextBlock Style="{DynamicResource HeaderTitle}" Text="{x:Static language:Language.metadataCountryHeaderTitel}" />
            <Canvas>
                <Path Style="{DynamicResource HeadertTitleLine}" />
            </Canvas>
            <TextBlock Style="{DynamicResource HeaderSubTitle}" Text="{x:Static language:Language.metadataCountryHeaderSubtitle}" />
        </StackPanel>
        <!--#endregion-->

        <!--#region Detail fields-->
        <Grid
            Grid.Row="1"
            HorizontalAlignment="Left"
            VerticalAlignment="Center">

            <Grid.RowDefinitions>
                <RowDefinition Height="32" />
                <RowDefinition Height="32" />
                <RowDefinition Height="32" />
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  Country code  -->
            <Label
                Grid.Row="0"
                Grid.Column="0"
                Content="{x:Static language:Language.metadataCountryEntryFieldCode}"
                Style="{DynamicResource EntryLabel}" />

            <Label
                Grid.Row="0"
                Grid.Column="1"
                Style="{DynamicResource EntrySemicolon}" />

            <TextBox
                Grid.Row="0"
                Grid.Column="2"
                Width="200"
                Style="{DynamicResource DefaultTextBox}"
                Tag="{x:Static language:Language.metadataCountryEntryFieldCodeTag}"
                Text="{Binding SelectedCountry.CountryCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                ToolTip="{x:Static language:Language.metadataCountryEntryFieldCodeTooltip}" />

            <!--  Country name  -->
            <Label
                Grid.Row="1"
                Grid.Column="0"
                Content="{x:Static language:Language.metadataCountryEntryFieldName}"
                Style="{DynamicResource EntryLabel}" />

            <Label
                Grid.Row="1"
                Grid.Column="1"
                Style="{DynamicResource EntrySemicolon}" />

            <TextBox
                Grid.Row="1"
                Grid.Column="2"
                Width="500"
                Style="{DynamicResource DefaultTextBox}"
                Tag="{x:Static language:Language.metadataCountryEntryFieldNameTag}"
                Text="{Binding SelectedCountry.CountryName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                ToolTip="{x:Static language:Language.metadataCountryEntryFieldNameTooltip}" />

            <!--  Default currency  -->
            <Label
                Grid.Row="2"
                Grid.Column="0"
                Content="{x:Static language:Language.metadataCountryEntryFieldCurrency}"
                Style="{DynamicResource EntryLabel}" />

            <Label
                Grid.Row="2"
                Grid.Column="1"
                Style="{DynamicResource EntrySemicolon}" />

            <syncfusion:ComboBoxAdv
                x:Name="CurrencyComboBox"
                Grid.Row="2"
                Grid.Column="2"
                Width="50"
                Height="25"
                HorizontalAlignment="Left"
                HorizontalContentAlignment="Center"
                ItemsSource="{Binding Currencies}"
                SelectedValue="{Binding SelectedCountry.CountryCurrencyId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                SelectedValuePath="CurrencyId"
                Tag="{x:Static language:Language.metadataCountryEntryFieldCurrencyTag}"
                ToolTip="{x:Static language:Language.metadataCountryEntryFieldCurrencyTooltip}">

                <!-- Dropdown met 3 kolommen -->
                <syncfusion:ComboBoxAdv.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30"/>
                                <ColumnDefinition Width="50"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding CurrencySymbol}" />
                            <TextBlock Grid.Column="1" Text="{Binding CurrencyCode}" />
                            <TextBlock Grid.Column="2" Text="{Binding CurrencyName}" />
                        </Grid>
                    </DataTemplate>
                </syncfusion:ComboBoxAdv.ItemTemplate>

                <!-- Geselecteerd item toont alleen CurrencySymbol -->
                <syncfusion:ComboBoxAdv.SelectionBoxTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding CurrencySymbol}" HorizontalAlignment="Center"/>
                    </DataTemplate>
                </syncfusion:ComboBoxAdv.SelectionBoxTemplate>
            </syncfusion:ComboBoxAdv>
        </Grid>
        <!--#endregion-->

        <!--#region Toolbar section-->
        <Border 
            Grid.Row="3" 
            BorderBrush="{DynamicResource DefaultBorderForeground}" 
            Background="{DynamicResource DefaultBorderBackground}" 
            BorderThickness="1" 
            CornerRadius="5"
            Margin="15,2,15,2" VerticalAlignment="Center">
            
            <Grid Margin="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="255" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!--#region Toolbar-->
                <StackPanel Orientation="Horizontal" Grid.Column="0" Margin="10,2,0,2">
                    <Button
                        Style="{StaticResource ActionBarButtonStyle}"
                        Command="{Binding AddCountryCommand}" 
                        ToolTip="{x:Static language:Language.toolbarButtonActionNew}">
                        <Image Style="{DynamicResource ToolBarAddIcon}" />
                    </Button>
                    
                    <Button 
                        Style="{StaticResource ActionBarButtonStyle}"
                        Click="ButtonDelete"
                        IsEnabled="{Binding CanDeleteCountry}"
                        ToolTip="{Binding DeleteDisabledReason}">
                        <Image Style="{DynamicResource ToolBarDeleteIcon}" />
                    </Button>
                    
                    <Button 
                        Style="{StaticResource ActionBarButtonStyle}"
                        Click="ButtonSave" 
                        ToolTip="{x:Static language:Language.toolbarButtonActionSave}">
                        <Image Style="{DynamicResource ToolBarSaveIcon}" />
                    </Button>
                    
                    <Border Style="{StaticResource ActionBarSeparatorStyle}" />
                    
                    <Button 
                        Style="{StaticResource ActionBarButtonStyle}"
                        Click="ButtonImport" 
                        ToolTip="{x:Static language:Language.toolbarButtonActionImport}">
                        <Image Style="{DynamicResource ToolBarImportIcon}" />
                    </Button>

                    <Button 
                        Style="{StaticResource ActionBarButtonStyle}"
                        Click="ButtonExport" 
                        ToolTip="{x:Static language:Language.toolbarButtonActionExport}">
                        <Image Style="{DynamicResource ToolBarExportIcon}" />
                    </Button>
                </StackPanel>
                <!--#endregion-->

                <TextBlock
                    Grid.Column="1"
                    Width="250"
                    Height="23" FontSize="14" FontWeight="Bold"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                    
                    <Run Text="{x:Static language:Language.toolbarVisibleRowLabelCountry}" />
                    <Run Text=": " />
                    <Run
                        FontSize="16"
                        Text="{Binding VisibleCountryCount, StringFormat={}{0:N0}}"
                        FontStyle="Italic" />
                    <Run Text=" " />
                    <Run Text="{x:Static language:Language.toolbarVisibleRowLabelNumberSeperator}" FontWeight="Normal"/>
                    <Run Text=" " />
                    <Run Text="{Binding TotalCountryCount, StringFormat={}{0:N0}, Mode=OneWay}" FontSize="16" FontWeight="Bold" FontStyle="Italic"/>

                </TextBlock>
                <!--#region Search field-->
                <!--  Icon  -->
                <Image
                x:Name="FilterIcon"
                Grid.Column="2"
                Width="20"
                Height="20"
                Margin="5"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Source="{StaticResource search}">
                    <Image.Triggers>
                        <EventTrigger RoutedEvent="Image.Loaded">
                            <BeginStoryboard>
                                <Storyboard AutoReverse="True" RepeatBehavior="Forever">
                                    <DoubleAnimation
                                    Storyboard.TargetProperty="Opacity"
                                    From="1.0"
                                    To="0.3"
                                    Duration="0:0:1" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Image.Triggers>
                </Image>

                <!--  Input field  -->
                <TextBox
                Grid.Column="3"
                Width="250"
                VerticalAlignment="Center"
                Style="{DynamicResource DefaultTextBox}"
                Tag="{x:Static language:Language.SearchGridTag}"
                Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                ToolTip="{x:Static language:Language.SearchGridTooltip}" />

                <!--  Clear button  -->
                <Button
                Grid.Column="4"
                Width="24"
                Height="24"
                Margin="5"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Command="{Binding ClearSearchCommand}"
                Style="{DynamicResource ClearButtonStyle}" />
                <!--#endregion-->
            </Grid>
        </Border>
        <!--#endregion-->

        <!--#region Datagrid-->
        <syncfusion:SfDataGrid
            x:Name="SfDataGrid"
            Grid.Row="4"
            Margin="15,3,15,5"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Top"
            AllowDraggingColumns="True"
            AllowGrouping="True"
            AllowSorting="True"
            AllowTriStateSorting="True"
            AutoGenerateColumns="False"
            ColumnSizer="Star"
            ItemsSource="{Binding Countries}"
            Loaded="CountryDataGrid_Loaded"
            SelectedItem="{Binding SelectedCountry, Mode=TwoWay}">

            <syncfusion:SfDataGrid.Columns>
                <!--#region hidden columns-->
                <syncfusion:GridTextColumn
                    Width="0"
                    IsHidden="True"
                    MappingName="CountryId" />
                <syncfusion:GridTextColumn
                    Width="0"
                    IsHidden="True"
                    MappingName="CountryCurrencyId" />
                <!--#endregion-->

                <!--#region Country Code-->
                <syncfusion:GridTemplateColumn
                    Width="120"
                    HeaderText="{x:Static language:Language.metadataCountryDatagridHeaderCountryCode_Label}"
                    MappingName="CountryCode">
                    <syncfusion:GridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock hlp:TextBlockHelper.HighlightText="{Binding DataContext.SearchText, RelativeSource={RelativeSource AncestorType=UserControl}}" Text="{Binding CountryCode}" />
                        </DataTemplate>
                    </syncfusion:GridTemplateColumn.CellTemplate>
                </syncfusion:GridTemplateColumn>
                <!--#endregion-->

                <!--#region Country Name-->
                <syncfusion:GridTemplateColumn HeaderText="{x:Static language:Language.metadataCountryDatagridHeaderCountryName_Label}" MappingName="CountryName">
                    <syncfusion:GridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock hlp:TextBlockHelper.HighlightText="{Binding DataContext.SearchText, RelativeSource={RelativeSource AncestorType=UserControl}}" Text="{Binding CountryName}" />
                        </DataTemplate>
                    </syncfusion:GridTemplateColumn.CellTemplate>
                </syncfusion:GridTemplateColumn>
                <!--#endregion-->

                <!--#region Country Currency Symbol-->
                <syncfusion:GridTemplateColumn
                    Width="120"
                    HeaderText="{x:Static language:Language.metadataCountryDatagridHeaderCountryCurrency_Label}"
                    MappingName="CountryCurrencySymbol">
                    <syncfusion:GridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <!-- Highlight the search text-->
                            <TextBlock hlp:TextBlockHelper.HighlightText="{Binding DataContext.SearchText, RelativeSource={RelativeSource AncestorType=UserControl}}" Text="{Binding CountryCurrencySymbol}" />
                        </DataTemplate>
                    </syncfusion:GridTemplateColumn.CellTemplate>
                </syncfusion:GridTemplateColumn>
                <!--#endregion-->
            </syncfusion:SfDataGrid.Columns>
        </syncfusion:SfDataGrid>
        <!--#endregion-->

        <!--#region Footer-->
        <Border Grid.Row="5" BorderBrush="{DynamicResource DefaultBorderForeground}" Background="{DynamicResource DefaultBorderBackground}" BorderThickness="1" CornerRadius="5">
            <Grid>
                <TextBlock Text="Status"/>
            </Grid>
        </Border>
        <!--#endregion-->
    </Grid>
</UserControl>
