<UserControl x:Class="Modelbouwer.Views.ProjectReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
             xmlns:chart="clr-namespace:Syncfusion.UI.Xaml.Charts;assembly=Syncfusion.SfChart.WPF"
             xmlns:viewmodels="clr-namespace:Modelbouwer.ViewModels"
             xmlns:language="clr-namespace:Modelbouwer.Resources.Languages"
             d:DataContext="{d:DesignInstance Type=viewmodels:ProjectReportsViewModel, IsDesignTimeCreatable=False}"
             mc:Ignorable="d">
    <UserControl.Resources>
        <Style x:Key="ReportViewToggleStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                        <Grid Width="{TemplateBinding Width}"
                              Height="{TemplateBinding Height}">
                            <Border x:Name="Track"
                                    CornerRadius="11"
                                    BorderBrush="#9AA8B8"
                                    BorderThickness="1"
                                    Background="#E8EEF6" />
                            <Ellipse x:Name="Thumb"
                                     Width="18"
                                     Height="18"
                                     Margin="2"
                                     HorizontalAlignment="Left"
                                     Fill="#FFFFFF"
                                     Stroke="#8B99AA"
                                     StrokeThickness="1">
                                <Ellipse.Effect>
                                    <DropShadowEffect BlurRadius="3"
                                                      Direction="315"
                                                      Opacity="0.22"
                                                      ShadowDepth="1" />
                                </Ellipse.Effect>
                            </Ellipse>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="BorderBrush" Value="#5F8DB8" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#D6E7F7" />
                                <Setter TargetName="Track" Property="BorderBrush" Value="#5F8DB8" />
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TimePieTooltipPathStyle" TargetType="Path">
            <Setter Property="Fill" Value="#F5F5F5" />
            <Setter Property="Stroke" Value="#183A5A" />
            <Setter Property="StrokeThickness" Value="1" />
        </Style>

        <DataTemplate x:Key="TimePieTooltipTemplate">
            <Border Padding="8,6"
                    Background="#F5F5F5"
                    BorderBrush="#183A5A"
                    BorderThickness="1"
                    CornerRadius="3">
                <StackPanel MinWidth="130">
                    <TextBlock FontWeight="SemiBold"
                               Foreground="#1F3550"
                               Text="{Binding Item.Name}" />
                    <Grid Margin="0,5,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Foreground="#43566A"
                                   Text="{x:Static language:Language.ProjectReportsHoursHeader}" />
                        <TextBlock Grid.Column="1"
                                   Margin="12,0,0,0"
                                   HorizontalAlignment="Right"
                                   FontWeight="SemiBold"
                                   Foreground="#1F3550"
                                   Text="{Binding Item.Hours, StringFormat={}{0:N2}}" />
                    </Grid>
                    <Grid Margin="0,2,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Foreground="#43566A"
                                   Text="{x:Static language:Language.ProjectReportsPercentageHeader}" />
                        <TextBlock Grid.Column="1"
                                   Margin="12,0,0,0"
                                   HorizontalAlignment="Right"
                                   FontWeight="SemiBold"
                                   Foreground="#1F3550"
                                   Text="{Binding Item.Percentage, StringFormat={}{0:P1}}" />
                    </Grid>
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="BarChartTooltipTemplate">
            <Border Padding="8,6"
                    Background="#F5F5F5"
                    BorderBrush="#183A5A"
                    BorderThickness="1"
                    CornerRadius="3">
                <StackPanel MinWidth="130">
                    <TextBlock FontWeight="SemiBold"
                               Foreground="#1F3550"
                               Text="{Binding Series.Label}" />
                    <Grid Margin="0,5,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Foreground="#43566A"
                                   Text="{Binding Item.Category}" />
                        <TextBlock Grid.Column="1"
                                   Margin="12,0,0,0"
                                   HorizontalAlignment="Right"
                                   FontWeight="SemiBold"
                                   Foreground="#1F3550"
                                   Text="{Binding Item.Value, StringFormat={}{0:N2}}" />
                    </Grid>
                </StackPanel>
            </Border>
        </DataTemplate>

        <Style x:Key="ReportChartBarStyle" TargetType="ProgressBar">
            <Setter Property="Height" Value="20" />
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="1" />
            <Setter Property="Foreground" Value="#2F80ED" />
            <Setter Property="Background" Value="#D7DEE8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ProgressBar}">
                        <Grid Height="{TemplateBinding Height}"
                              SnapsToDevicePixels="True">
                            <Border Margin="0,3,0,0"
                                    Background="#9AA8B8"
                                    CornerRadius="3"
                                    Opacity="0.55" />
                            <Border x:Name="PART_Track"
                                    Margin="0,0,0,2"
                                    CornerRadius="3"
                                    BorderBrush="#AAB5C3"
                                    BorderThickness="1">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#F7F9FC" Offset="0" />
                                        <GradientStop Color="#DCE3EC" Offset="0.48" />
                                        <GradientStop Color="#B8C4D1" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <Border x:Name="PART_Indicator"
                                    Margin="1,1,1,3"
                                    HorizontalAlignment="Left"
                                    CornerRadius="2"
                                    BorderBrush="#1B5FAE"
                                    BorderThickness="1">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="4"
                                                      Direction="315"
                                                      Opacity="0.26"
                                                      ShadowDepth="2"
                                                      Color="#394B5F" />
                                </Border.Effect>
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#8FC5FF" Offset="0" />
                                        <GradientStop Color="#2F80ED" Offset="0.42" />
                                        <GradientStop Color="#1756AA" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <Border Margin="2,2,2,0"
                                    Height="5"
                                    VerticalAlignment="Top"
                                    CornerRadius="2"
                                    Opacity="0.55">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#FFFFFF" Offset="0" />
                                        <GradientStop Color="#00FFFFFF" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="ReportChartItemTemplate">
            <Grid Margin="0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="80" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           VerticalAlignment="Center"
                           Text="{Binding Name}"
                           TextTrimming="CharacterEllipsis" />
                <ProgressBar Grid.Column="1"
                             Margin="8,0"
                             Style="{StaticResource ReportChartBarStyle}"
                             Value="{Binding Percentage}" />
                <TextBlock Grid.Column="2"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right"
                           Text="{Binding Hours, StringFormat={}{0:N2}}" />
            </Grid>
        </DataTemplate>

        <ItemsPanelTemplate x:Key="PieChartItemsPanelTemplate">
            <Canvas Width="220" Height="150" />
        </ItemsPanelTemplate>

        <DataTemplate x:Key="PieChartSliceTemplate">
            <Grid>
                <Path Data="{Binding ShadowGeometry}"
                      Fill="{Binding ShadowFill}"
                      Opacity="0.72"
                      Stroke="#506070"
                      StrokeThickness="0.35" />
                <Path Data="{Binding SliceGeometry}"
                      Fill="{Binding Fill}"
                      Stroke="#FFFFFF"
                      StrokeThickness="1.2">
                    <Path.Effect>
                        <DropShadowEffect BlurRadius="3"
                                          Direction="315"
                                          Opacity="0.18"
                                          ShadowDepth="1"
                                          Color="#263544" />
                    </Path.Effect>
                </Path>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="PieChartLegendTemplate">
            <Grid Margin="0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="76" />
                    <ColumnDefinition Width="58" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0"
                        Width="12"
                        Height="12"
                        VerticalAlignment="Center"
                        Background="{Binding Fill}"
                        BorderBrush="#FFFFFF"
                        BorderThickness="1" />
                <TextBlock Grid.Column="1"
                           VerticalAlignment="Center"
                           Text="{Binding Name}"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="2"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           Text="{Binding Hours, StringFormat={}{0:N2}}" />
                <TextBlock Grid.Column="3"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           Text="{Binding Percentage, StringFormat={}{0:P1}}" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="CostChartItemTemplate">
            <Grid Margin="0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="90" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           VerticalAlignment="Center"
                           Text="{Binding Name}"
                           TextTrimming="CharacterEllipsis" />
                <ProgressBar Grid.Column="1"
                             Margin="8,0"
                             Style="{StaticResource ReportChartBarStyle}"
                             Value="{Binding Percentage}" />
                <TextBlock Grid.Column="2"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right"
                           Text="{Binding TotalCosts, StringFormat={}{0:N2}}" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="85" />
            <RowDefinition Height="92" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0"
                    VerticalAlignment="Center"
                    Background="{DynamicResource HeaderBackground}">
            <StackPanel Orientation="Horizontal" Margin="10,0,0,0">
                <Image Style="{DynamicResource HeaderIconStyle}" Source="{StaticResource Report}" />
                <TextBlock Style="{DynamicResource HeaderTitle}" Text="{x:Static language:Language.ProjectReportsHeaderTitle}" />
            </StackPanel>
            <Canvas>
                <Path Style="{DynamicResource HeadertTitleLine}" />
            </Canvas>
            <StackPanel Orientation="Horizontal">
                <TextBlock Style="{DynamicResource HeaderSubTitle}" Text="{x:Static language:Language.ProjectReportsHeaderSubtitle}" />
            </StackPanel>
        </StackPanel>

        <GroupBox Grid.Row="1" Margin="10,6">
            <GroupBox.Header>
                <StackPanel Orientation="Horizontal">
                    <Image Source="{StaticResource Projects}" Style="{DynamicResource ImageHeaderGroup}" />
                    <TextBlock Text="{x:Static language:Language.TimeRegistrationProjectGroupTitle}" Style="{DynamicResource TextBlockBold}" />
                </StackPanel>
            </GroupBox.Header>
            <Grid Margin="6,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="360" />
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="210" />
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Label Grid.Column="0"
                       VerticalAlignment="Center"
                       Content="{x:Static language:Language.TimeRegistrationSelectProjectLabel}"
                       Style="{DynamicResource EntryLabelHorizontal}" />
                <syncfusion:ComboBoxAdv Grid.Column="1"
                                        Height="28"
                                        VerticalAlignment="Center"
                                        AutoCompleteMode="Suggest"
                                        DefaultText="{x:Static language:Language.TimeRegistrationDefaultProjectText}"
                                        DisplayMemberPath="ProjectName"
                                        ItemsSource="{Binding Projects}"
                                        SelectedItem="{Binding SelectedProject, Mode=TwoWay}"
                                        SelectedValuePath="ProjectId"
                                        TextSearch.TextPath="ProjectName" />
                <Button Grid.Column="2"
                        Width="28"
                        Height="28"
                        Command="{Binding RefreshCommand}"
                        Style="{StaticResource ActionBarButtonStyle}"
                        ToolTip="{x:Static language:Language.TimeRegistrationRefreshTooltip}">
                    <Image Style="{DynamicResource ToolBarResetSettingsIcon}" />
                </Button>
                <StackPanel Grid.Column="3"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="10,0,0,0">
                    <TextBlock VerticalAlignment="Center"
                               FontWeight="SemiBold"
                               Text="{x:Static language:Language.TimeRegistrationIncludeHoursLabel}" />
                    <ToggleButton Margin="8,0,0,0"
                                  Style="{StaticResource ToggleSwitchStyle}"
                                  IsChecked="{Binding IncludeHoursInCosts, Mode=TwoWay}" />
                </StackPanel>
                <TextBlock Grid.Column="4"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right"
                           Margin="10,0">
                    <Run Text="{x:Static language:Language.TimeRegistrationHourRatePrefix}" />
                    <Run Text="{Binding HourRateDisplay, Mode=OneWay}" />
                </TextBlock>
                <TextBlock Grid.Column="5"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right"
                           Margin="10,0"
                           FontWeight="SemiBold">
                    <Run Text="{x:Static language:Language.ProjectReportsTotalHoursPrefix}" />
                    <Run Text="{Binding TotalHours, Mode=OneWay, StringFormat={}{0:N2}}" />
                    <Run Text="{x:Static language:Language.ProjectReportsTotalCostsPrefix}" />
                    <Run Text="{Binding TotalReportCosts, Mode=OneWay, StringFormat={}{0:N2}}" />
                </TextBlock>
            </Grid>
        </GroupBox>

        <syncfusion:TabControlExt Grid.Row="2"
                                  Margin="10,4,10,8"
                                  SelectedIndex="{Binding SelectedReportTabIndex, Mode=TwoWay}"
                                  IsLazyLoaded="False"
                                  IsDisableUnloadTabItemExtContent="True"
                                  TabStripPlacement="Bottom"
                                  CloseButtonType="Hide"
                                  TabListContextMenuOptions="Default"
                                  TabItemHeaderStyle="Curve">
            <syncfusion:TabItemExt Header="{x:Static language:Language.ProjectReportsWeekdayTabTitle}" Image="{StaticResource Time}" ImageWidth="17" ImageHeight="17">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Margin="0,0,0,4">
                        <TextBlock VerticalAlignment="Center" Text="{x:Static language:Language.ProjectReportsChartViewLabel}" />
                        <ToggleButton Margin="8,0"
                                      IsChecked="{Binding WeekdayShowsTable, Mode=TwoWay}"
                                      Style="{StaticResource ReportViewToggleStyle}" />
                        <TextBlock VerticalAlignment="Center" Text="{x:Static language:Language.ProjectReportsTableViewLabel}" />
                    </StackPanel>
                    <chart:SfChart3D Grid.Row="1"
                                     Margin="0,4"
                                     Background="Transparent"
                                     Rotation="35"
                                     Tilt="-25"
                                     Depth="70"
                                     PerspectiveAngle="55"
                                     EnableRotation="True"
                                     chart:DoughnutSeries3D.DoughnutHoleSize="0.2"
                                     Visibility="{Binding WeekdayShowsTable, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                        <chart:SfChart3D.Legend>
                            <chart:ChartLegend DockPosition="Right"
                                               CheckBoxVisibility="Collapsed" />
                        </chart:SfChart3D.Legend>
                        <chart:DoughnutSeries3D ItemsSource="{Binding WeekdayHours}"
                                                XBindingPath="Name"
                                                YBindingPath="Hours"
                                                DoughnutCoefficient="0.95"
                                                CircleCoefficient="0.78"
                                                EnableAnimation="True"
                                                AnimationDuration="0:0:0.7"
                                                ShowTooltip="True"
                                                TooltipTemplate="{StaticResource TimePieTooltipTemplate}"
                                                chart:ChartTooltip.EnableAnimation="True" />
                    </chart:SfChart3D>
                    <syncfusion:SfDataGrid Grid.Row="1"
                                           Margin="0,4"
                                           AllowEditing="False"
                                           AllowFiltering="True"
                                           AllowGrouping="False"
                                           AllowResizingColumns="True"
                                           AllowSorting="True"
                                           AutoGenerateColumns="False"
                                           ColumnSizer="Star"
                                           ItemsSource="{Binding WeekdayHours}"
                                           Visibility="{Binding WeekdayShowsTable, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <syncfusion:SfDataGrid.TableSummaryRows>
                            <syncfusion:GridTableSummaryRow
                                Position="Bottom"
                                ShowSummaryInRow="False"
                                Title="{x:Static language:Language.ProjectReportsDataGridSummaryText}"
                                TitleColumnCount="1">
                                <syncfusion:GridSummaryRow.SummaryColumns>
                                    <syncfusion:GridSummaryColumn
                                        Name="Hours"
                                        MappingName="Hours"
                                        SummaryType="DoubleAggregate"
                                        Format="'{Sum:N2}'" />
                                </syncfusion:GridSummaryRow.SummaryColumns>
                            </syncfusion:GridTableSummaryRow>
                        </syncfusion:SfDataGrid.TableSummaryRows>
                        <syncfusion:SfDataGrid.Columns>
                            <syncfusion:GridTextColumn Width="220" MappingName="Name" HeaderText="{x:Static language:Language.ProjectReportsPeriodHeader}" />
                            <syncfusion:GridNumericColumn Width="120" MappingName="Hours" HeaderText="{x:Static language:Language.ProjectReportsHoursHeader}" NumberDecimalDigits="2" HorizontalHeaderContentAlignment="Right" />
                            <syncfusion:GridPercentColumn Width="120" MappingName="Percentage" HeaderText="{x:Static language:Language.ProjectReportsPercentageHeader}" HorizontalHeaderContentAlignment="Right" />
                        </syncfusion:SfDataGrid.Columns>
                    </syncfusion:SfDataGrid>
                </Grid>
            </syncfusion:TabItemExt>

            <syncfusion:TabItemExt Header="{x:Static language:Language.ProjectReportsMonthTabTitle}" Image="{StaticResource Time}" ImageWidth="17" ImageHeight="17">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Margin="0,0,0,4">
                        <TextBlock VerticalAlignment="Center" Text="{x:Static language:Language.ProjectReportsChartViewLabel}" />
                        <ToggleButton Margin="8,0"
                                      IsChecked="{Binding MonthShowsTable, Mode=TwoWay}"
                                      Style="{StaticResource ReportViewToggleStyle}" />
                        <TextBlock VerticalAlignment="Center" Text="{x:Static language:Language.ProjectReportsTableViewLabel}" />
                    </StackPanel>
                    <chart:SfChart3D Grid.Row="1"
                                     Margin="0,4,0,16"
                                     Background="Transparent"
                                     Rotation="35"
                                     Tilt="-25"
                                     Depth="70"
                                     PerspectiveAngle="55"
                                     EnableRotation="True"
                                     chart:DoughnutSeries3D.DoughnutHoleSize="0.2"
                                     Visibility="{Binding MonthShowsTable, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                        <chart:SfChart3D.Legend>
                            <chart:ChartLegend DockPosition="Bottom"
                                               Orientation="Horizontal"
                                               CheckBoxVisibility="Collapsed" />
                        </chart:SfChart3D.Legend>
                        <chart:DoughnutSeries3D ItemsSource="{Binding MonthHours}"
                                                XBindingPath="Name"
                                                YBindingPath="Hours"
                                                DoughnutCoefficient="0.95"
                                                CircleCoefficient="0.58"
                                                EnableAnimation="True"
                                                AnimationDuration="0:0:0.7"
                                                ShowTooltip="True"
                                                TooltipTemplate="{StaticResource TimePieTooltipTemplate}"
                                                chart:ChartTooltip.EnableAnimation="True" />
                    </chart:SfChart3D>
                    <syncfusion:SfDataGrid Grid.Row="1" Margin="0,4" AllowEditing="False" AllowFiltering="True" AllowResizingColumns="True" AllowSorting="True" AutoGenerateColumns="False" ColumnSizer="Star" ItemsSource="{Binding MonthHours}" Visibility="{Binding MonthShowsTable, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <syncfusion:SfDataGrid.TableSummaryRows>
                            <syncfusion:GridTableSummaryRow Position="Bottom" ShowSummaryInRow="False" Title="{x:Static language:Language.ProjectReportsDataGridSummaryText}" TitleColumnCount="1">
                                <syncfusion:GridSummaryRow.SummaryColumns>
                                    <syncfusion:GridSummaryColumn Name="Hours" MappingName="Hours" SummaryType="DoubleAggregate" Format="'{Sum:N2}'" />
                                </syncfusion:GridSummaryRow.SummaryColumns>
                            </syncfusion:GridTableSummaryRow>
                        </syncfusion:SfDataGrid.TableSummaryRows>
                        <syncfusion:SfDataGrid.Columns>
                            <syncfusion:GridTextColumn Width="220" MappingName="Name" HeaderText="{x:Static language:Language.ProjectReportsPeriodHeader}" />
                            <syncfusion:GridNumericColumn Width="120" MappingName="Hours" HeaderText="{x:Static language:Language.ProjectReportsHoursHeader}" NumberDecimalDigits="2" HorizontalHeaderContentAlignment="Right" />
                            <syncfusion:GridPercentColumn Width="120" MappingName="Percentage" HeaderText="{x:Static language:Language.ProjectReportsPercentageHeader}" HorizontalHeaderContentAlignment="Right" />
                        </syncfusion:SfDataGrid.Columns>
                    </syncfusion:SfDataGrid>
                </Grid>
            </syncfusion:TabItemExt>

            <syncfusion:TabItemExt Header="{x:Static language:Language.ProjectReportsYearTabTitle}" Image="{StaticResource Time}" ImageWidth="17" ImageHeight="17">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Margin="0,0,0,4">
                        <TextBlock VerticalAlignment="Center" Text="{x:Static language:Language.ProjectReportsChartViewLabel}" />
                        <ToggleButton Margin="8,0"
                                      IsChecked="{Binding YearShowsTable, Mode=TwoWay}"
                                      Style="{StaticResource ReportViewToggleStyle}" />
                        <TextBlock VerticalAlignment="Center" Text="{x:Static language:Language.ProjectReportsTableViewLabel}" />
                    </StackPanel>
                    <chart:SfChart3D Grid.Row="1"
                                     Margin="0,4,0,16"
                                     Background="Transparent"
                                     Rotation="35"
                                     Tilt="-25"
                                     Depth="70"
                                     PerspectiveAngle="55"
                                     EnableRotation="True"
                                     chart:DoughnutSeries3D.DoughnutHoleSize="0.2"
                                     Visibility="{Binding YearShowsTable, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                        <chart:SfChart3D.Legend>
                            <chart:ChartLegend DockPosition="Bottom"
                                               Orientation="Horizontal"
                                               CheckBoxVisibility="Collapsed" />
                        </chart:SfChart3D.Legend>
                        <chart:DoughnutSeries3D ItemsSource="{Binding YearHours}"
                                                XBindingPath="Name"
                                                YBindingPath="Hours"
                                                DoughnutCoefficient="0.95"
                                                CircleCoefficient="0.62"
                                                EnableAnimation="True"
                                                AnimationDuration="0:0:0.7"
                                                ShowTooltip="True"
                                                TooltipTemplate="{StaticResource TimePieTooltipTemplate}"
                                                chart:ChartTooltip.EnableAnimation="True" />
                    </chart:SfChart3D>
                    <syncfusion:SfDataGrid Grid.Row="1" Margin="0,4" AllowEditing="False" AllowFiltering="True" AllowResizingColumns="True" AllowSorting="True" AutoGenerateColumns="False" ColumnSizer="Star" ItemsSource="{Binding YearHours}" Visibility="{Binding YearShowsTable, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <syncfusion:SfDataGrid.TableSummaryRows>
                            <syncfusion:GridTableSummaryRow Position="Bottom" ShowSummaryInRow="False" Title="{x:Static language:Language.ProjectReportsDataGridSummaryText}" TitleColumnCount="1">
                                <syncfusion:GridSummaryRow.SummaryColumns>
                                    <syncfusion:GridSummaryColumn Name="Hours" MappingName="Hours" SummaryType="DoubleAggregate" Format="'{Sum:N2}'" />
                                </syncfusion:GridSummaryRow.SummaryColumns>
                            </syncfusion:GridTableSummaryRow>
                        </syncfusion:SfDataGrid.TableSummaryRows>
                        <syncfusion:SfDataGrid.Columns>
                            <syncfusion:GridTextColumn Width="220" MappingName="Name" HeaderText="{x:Static language:Language.ProjectReportsPeriodHeader}" />
                            <syncfusion:GridNumericColumn Width="120" MappingName="Hours" HeaderText="{x:Static language:Language.ProjectReportsHoursHeader}" NumberDecimalDigits="2" HorizontalHeaderContentAlignment="Right" />
                            <syncfusion:GridPercentColumn Width="120" MappingName="Percentage" HeaderText="{x:Static language:Language.ProjectReportsPercentageHeader}" HorizontalHeaderContentAlignment="Right" />
                        </syncfusion:SfDataGrid.Columns>
                    </syncfusion:SfDataGrid>
                </Grid>
            </syncfusion:TabItemExt>

            <syncfusion:TabItemExt Header="{x:Static language:Language.ProjectReportsMonthYearTabTitle}" Image="{StaticResource Time}" ImageWidth="17" ImageHeight="17">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Margin="0,0,0,4">
                        <TextBlock VerticalAlignment="Center" Text="{x:Static language:Language.ProjectReportsChartViewLabel}" />
                        <ToggleButton Margin="8,0"
