<UserControl x:Class="Modelbouwer.Views.ProjectView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:hlp="clr-namespace:Modelbouwer.Helpers"
             xmlns:language="clr-namespace:Modelbouwer.Resources.Languages"
             xmlns:local="clr-namespace:Modelbouwer.Views"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
             xmlns:viewmodels="clr-namespace:Modelbouwer.ViewModels"
             xmlns:helpers="clr-namespace:Modelbouwer.Helpers"
             xmlns:converters="clr-namespace:Modelbouwer.Converters"
             xmlns:controls="clr-namespace:Modelbouwer.Controls"
             d:DataContext="{d:DesignInstance Type=viewmodels:ProjectPageViewModel}"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch"
             mc:Ignorable="d">

    <UserControl.Resources>
        <converters:ByteToImageConverter x:Key="ByteToImageConverter" DefaultImage="{StaticResource noimage}" />
        <converters:ByteToImageConverter x:Key="NullOrEmptyImageConverter" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="85" />
            <!-- Header -->
            <RowDefinition Height="190" />
            <!-- Detail fields -->
            <RowDefinition Height="2" />
            <!-- Spacer -->
            <RowDefinition Height="250" />
            <!-- Rtf Editor -->
            <RowDefinition Height="40" />
            <!-- Toolbar -->
            <RowDefinition Height="*" />
            <!-- DataGrid -->
            <RowDefinition Height="25" />
            <!-- Footer -->
        </Grid.RowDefinitions>

        <!--#region Page header-->
        <StackPanel
            Grid.Row="0"
            VerticalAlignment="Center"
            Background="{DynamicResource HeaderBackground}">
            <StackPanel Orientation="Horizontal" Margin="10,0,0,0">
                <Image
                    Style="{DynamicResource HeaderIconStyle}"
                    Source="{StaticResource Projects}" />
                <TextBlock Style="{DynamicResource HeaderTitle}" Text="{x:Static language:Language.metadataProjectHeaderTitel}" />
            </StackPanel>
            <Canvas>
                <Path Style="{DynamicResource HeadertTitleLine}" />
            </Canvas>
            <TextBlock Style="{DynamicResource HeaderSubTitle}" Text="{x:Static language:Language.metadataProjectHeaderSubtitle}" />
        </StackPanel>
        <!--#endregion-->

        <!--#region Detail fields-->
        <Grid
            Grid.Row="1"
            HorizontalAlignment="Left"
            VerticalAlignment="Center">

            <Grid.RowDefinitions>
                <RowDefinition Height="20" />
                <RowDefinition Height="32" />
                <RowDefinition Height="20" />
                <RowDefinition Height="32" />
                <RowDefinition Height="81" />
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="160" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="160" />
            </Grid.ColumnDefinitions>

            <!--#region  Project code  -->
            <StackPanel Orientation="Horizontal" Grid.Row="0" Grid.Column="0">
                <Label Content="{x:Static language:Language.metadataProjectTabGeneralTabItemGeneralFieldCode}"
                       Style="{DynamicResource EntryLabel}" />

                <Label Style="{DynamicResource EntrySemicolon}" />
            </StackPanel>

            <TextBox
                Grid.Row="1"
                Grid.Column="0"
                Margin="5 0 0 0"
                Width="150"
                Style="{DynamicResource DefaultTextBox}"
                Tag="{x:Static language:Language.metadataProjectTabGeneralTabItemGeneralFieldCodeTag}"
                Text="{Binding SelectedItem.ProjectCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                ToolTip="{x:Static language:Language.metadataProjectTabGeneralTabItemGeneralFieldCodeTooltip}" />
            <!--#endregion-->

            <!--#region  Project name  -->
            <StackPanel Orientation="Horizontal" Grid.Row="0" Grid.Column="1">
                <Label
                    Content="{x:Static language:Language.metadataProjectTabGeneralTabItemGeneralFieldName}"
                    Style="{DynamicResource EntryLabel}" />

                <Label
                    Style="{DynamicResource EntrySemicolon}" />
            </StackPanel>

            <TextBox
                Grid.Row="1"
                Margin="5 0 0 0"
                Grid.Column="1"
                Width="500"
                Style="{DynamicResource DefaultTextBox}"
                Tag="{x:Static language:Language.metadataProjectTabGeneralTabItemGeneralFieldNameTag}"
                Text="{Binding SelectedItem.ProjectName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                ToolTip="{x:Static language:Language.metadataProjectTabGeneralTabItemGeneralFieldNameTooltip}" />
            <!--#endregion-->

            <!--#region Start date  -->
            <StackPanel Orientation="Horizontal" Grid.Row="2" Grid.Column="0">
                <Label
                    Content="{x:Static language:Language.metadataProjectTabGeneralTabItemGeneralFieldStartDate}"
                    Style="{DynamicResource EntryLabel}" />

                <Label
                    Style="{DynamicResource EntrySemicolon}" />
            </StackPanel>

            <DatePicker
                x:Name="ProjectStartDate"
                Grid.Row="3"
                Grid.Column="0"
                Margin="5 0 0 0"
                Width="150"
                HorizontalAlignment="Left"
                Style="{DynamicResource DefaultDatePicker}"
                Tag="{x:Static language:Language.metadataProjectTabGeneralTabItemGeneralFieldStartDateTag}"
                SelectedDate="{Binding SelectedItem.ProjectStartDate,Mode=TwoWay, Converter={StaticResource DateOnlyConverter}}"
                ToolTip="{x:Static language:Language.metadataProjectTabGeneralTabItemGeneralFieldStartDateTooltip}"
                />
            <!--#endregion-->

            <!--#region End date, Close toggle and Expected Build Time-->
            <Grid Grid.Row="2" Grid.Column="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- End date -->
                <StackPanel Orientation="Horizontal" Grid.Row="0" Grid.Column="0">
                    <Label
                        Content="{x:Static language:Language.metadataProjectTabGeneralTabItemGeneralFieldEndDate}"
                        Style="{DynamicResource EntryLabel}"
                        Visibility="{Binding EndDatePickerVisibility}"/>

                    <Label
                        Content="{x:Static language:Language.metadataProjectTabGeneralTabItemGeneralFieldExpectedEndDate}"
                        Style="{DynamicResource EntryLabel}"
                        Visibility="{Binding ExpectedEndDateVisibility}"/>

                    <Label
                        Style="{DynamicResource EntrySemicolon}" />
                </StackPanel>

                <!-- Close toggle -->
                <StackPanel Orientation="Horizontal" Grid.Row="0" Grid.Column="1">
                    <Label
                        Content="{x:Static language:Language.metadataProjectTabGeneralTabItemGeneralFieldStatus}"
                        Style="{DynamicResource EntryLabel}" />

                    <Label
                        Style="{DynamicResource EntrySemicolon}" />
                </StackPanel>

                <!-- Expected Build hours -->
                <StackPanel Orientation="Horizontal" Grid.Row="0" Grid.Column="2">
                    <Label
                        Content="{x:Static language:Language.metadataProjectTabGeneralTabItemGeneralFieldExpectedWorkTime}"
                        Style="{DynamicResource EntryLabel}" />

                    <Label
                        Style="{DynamicResource EntrySemicolon}" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="3" Grid.Column="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- End date -->
                <DatePicker
                    x:Name="ProjectEndDate"
                    Grid.Column="0"
                    Width="150" Margin="5,0,0,0"
                    HorizontalAlignment="Left"
                    Style="{DynamicResource DefaultDatePicker}"
                    Tag="{x:Static language:Language.metadataProjectTabGeneralTabItemGeneralFieldEndDateTag}"
                    SelectedDate="{Binding SelectedItem.ProjectEndDate,Mode=TwoWay, Converter={StaticResource DateOnlyConverter}}"
                    ToolTip="{x:Static language:Language.metadataProjectTabGeneralTabItemGeneralFieldEndDateTooltip}" Grid.ColumnSpan="2"
                    Visibility="{Binding EndDatePickerVisibility}" />

                <TextBox
                    Visibility="{Binding ExpectedEndDateVisibility}"
                    Style="{DynamicResource DefaultTextBox}"
                    ToolTip="{x:Static language:Language.metadataProjectTabGeneralTabItemGeneralFieldExpectedEndDateTooltip}"
                    Tag="{x:Static language:Language.metadataProjectTabGeneralTabItemGeneralFieldExpectedEndDateTag}"
                    Grid.Column="0" Width="150"
                    Margin="5,0,0,0"
                    VerticalContentAlignment="Center"
                    Text="{Binding ProjectExpectedEndDate, Mode=OneWay, StringFormat={}{0:dd-MM-yyyy}}" Padding="2,0,2,0" />

                <!-- Status toggle -->
                <ToggleButton
                    Grid.Column="1"
                    Margin="5,0,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    BorderBrush="White"
                    IsChecked="{Binding SelectedItem.ProjectClosed, Mode=TwoWay}"
                    Style="{StaticResource SwitchButton}"/>

                <TextBox
                    Margin="5,4,0,4"
                    Grid.Column="2"
                    Width="120"
                    Style="{DynamicResource DefaultTextBox}"
                    Tag="{x:Static language:Language.metadataProjectTabGeneralTabItemGeneralFieldExpectedWorkTimeTag}"
                    Text="{Binding SelectedItem.ProjectExpectedTime, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    ToolTip="{x:Static language:Language.metadataProjectTabGeneralTabItemGeneralFieldExpectedWorkTimeTooltip}" />
            </Grid>
            <!--#endregion-->

            <!--#region Image and Image toolbar -->
            <Grid Grid.Row="0" Grid.Column="3" Grid.RowSpan="5" Height="183" VerticalAlignment="Top">
                <controls:ImageEditor
                    ImageSource="{Binding SelectedItem.ProjectImage, Mode=TwoWay}"
                    RotationAngle="{Binding SelectedItem.ProjectImageRotationAngle, Mode=TwoWay}"
                    AddImageCommand="{Binding AddImageCommand}"
                    DeleteImageCommand="{Binding DeleteProjectImageCommand}"
                    RotateCommand="{Binding RotateCommand}" />
            </Grid>
            <!--#endregion-->
        </Grid>

        <!--#region Memo field section -->
        <controls:RtfEditor
            x:Name="ProjectMemoEditor"
            Grid.Row="3"
            Grid.Column="1"
            Margin="5"
            RtfText="{Binding SelectedItem.ProjectMemo, Mode=TwoWay, UpdateSourceTrigger=Explicit}" />
        <!--#endregion-->
        <!--#endregion-->

        <!--#region Toolbar section-->
        <Grid Grid.Row="4"
              Margin="15,2,15,2"
              VerticalAlignment="Center">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="250" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock
                Text="{Binding ImportStatus}"
                Foreground="Gray"
                FontStyle="Italic"
                Margin="5"
                Visibility="{Binding IsImporting, Converter={StaticResource BooleanToVisibilityConverter}}"
                TextWrapping="Wrap"/>

            <!--#region Toolbar-->
            <StackPanel Orientation="Horizontal" Grid.Column="0" Margin="10,2,0,2">
                <Button
                    Style="{StaticResource ActionBarButtonStyle}"
                    Command="{Binding AddProjectCommand}"
                    ToolTip="{x:Static language:Language.toolbarButtonActionNew}">
                    <Image Style="{DynamicResource ToolBarAddIcon}" />
                </Button>

                <Button
                    Style="{StaticResource ActionBarButtonStyle}"
                    Command="{Binding DeleteProjectCommand}"
                    ToolTip="{x:Static language:Language.toolbarButtonActionDelete}">
                    <Image Style="{DynamicResource ToolBarDeleteIcon}" />
                </Button>

                <Button
                    Style="{StaticResource ActionBarButtonStyle}"
                    Command="{Binding SaveProjectCommand}"
                    ToolTip="{x:Static language:Language.toolbarButtonActionSave}">
                    <Image Style="{DynamicResource ToolBarSaveIcon}" />
                </Button>

                <Border Style="{StaticResource ActionBarSeparatorStyle}" />

                <Button
                    Style="{StaticResource ActionBarButtonStyle}"
                    Click="ButtonImport"
                    ToolTip="{x:Static language:Language.toolbarButtonActionImport}">
                    <Image Style="{DynamicResource ToolBarImportIcon}" />
                </Button>

                <Button
                    Style="{StaticResource ActionBarButtonStyle}"
                    Click="ButtonCSVExport"
                    ToolTip="{x:Static language:Language.toolbarButtonActionExportCSV}">
                    <Image Style="{DynamicResource ToolBarCSVExportIcon}" />
                </Button>

                <Button
                    Style="{StaticResource ActionBarButtonStyle}"
                    Click="ButtonExcelExport"
                    ToolTip="{x:Static language:Language.toolbarButtonActionExportExcel}">
                    <Image Style="{DynamicResource ToolBarExcelExportIcon}" />
                </Button>
            </StackPanel>
            <!--#endregion-->

            <!--#region Record Count Section -->
            <TextBlock
                Grid.Column="1"
                Width="Auto"
                Height="23" FontSize="14" FontWeight="Bold"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

                <Run Text="{x:Static language:Language.toolbarVisibleRowLabelProject}" />
                <Run Text=": " />
                <Run
                    FontSize="16"
                    Text="{Binding VisibleItemCount, StringFormat={}{0:N0}}"
                    FontStyle="Italic" />
                <Run Text=" " />
                <Run Text="{x:Static language:Language.toolbarVisibleRowLabelNumberSeperator}" FontWeight="Normal"/>
                <Run Text=" " />
                <Run Text="{Binding TotalProjectCount, StringFormat={}{0:N0}, Mode=OneWay}" FontSize="16" FontWeight="Bold" FontStyle="Italic"/>
            </TextBlock>
            <!--#endregion-->

            <!--#region Search field-->
            <!--  Icon  -->
            <Image
                x:Name="FilterIcon"
                Grid.Column="2"
                Width="20"
                Height="20"
                Margin="5"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Source="{StaticResource search}">
                <Image.Triggers>
                    <EventTrigger RoutedEvent="Image.Loaded">
                        <BeginStoryboard>
                            <Storyboard AutoReverse="True" RepeatBehavior="Forever">
                                <DoubleAnimation
                                    Storyboard.TargetProperty="Opacity"
                                    From="1.0"
                                    To="0.3"
                                    Duration="0:0:1" />
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Image.Triggers>
            </Image>

            <!--  Input field  -->
            <TextBox
                Grid.Column="3"
                Width="250"
                VerticalAlignment="Center"
                Style="{DynamicResource DefaultTextBox}"
                Tag="{x:Static language:Language.SearchGridTag}"
                Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                ToolTip="{x:Static language:Language.SearchGridTooltip}" />

            <!--  Clear button  -->
            <Button
                Grid.Column="4"
                Width="24"
                Height="24"
                Margin="5"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Command="{Binding ClearSearchCommand}"
                Style="{DynamicResource ClearButtonStyle}" />
            <!--#endregion-->
        </Grid>
        <!--#endregion-->

        <!--#region Datagrid-->
        <syncfusion:SfDataGrid
            x:Name="SfDataGrid"
            Grid.Row="5"
            Margin="15,3,15,5"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Top"
            AllowDraggingColumns="True"
            AllowGrouping="True"
            AllowSorting="True"
            AllowTriStateSorting="True"
            AutoGenerateColumns="False"
            ColumnSizer="Star"
            ItemsSource="{Binding Projects}"
            Loaded="ProjectDataGrid_Loaded"
            SelectedItem="{Binding SelectedItem, Mode=TwoWay}">

            <syncfusion:SfDataGrid.Columns>
                <!--#region hidden columns-->
                <syncfusion:GridTextColumn
                    Width="0"
                    IsHidden="True"
                    MappingName="ProjectId" />
                <!--#endregion-->

                <!--#region Project Code-->
                <syncfusion:GridTemplateColumn
                    Width="150"
                    HeaderText="{x:Static language:Language.metadataProjectDatagridHeaderCodeLabel}"
                    MappingName="ProjectCode">
                    <syncfusion:GridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock
                                Margin="5 0"
                                hlp:TextBlockHelper.HighlightText="{Binding DataContext.SearchText, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                Text="{Binding ProjectCode}" />
                        </DataTemplate>
                    </syncfusion:GridTemplateColumn.CellTemplate>
                </syncfusion:GridTemplateColumn>
                <!--#endregion-->

                <!--#region Project Name-->
                <syncfusion:GridTemplateColumn
                    HeaderText="{x:Static language:Language.metadataProjectDatagridHeaderNameLabel}"
                    MappingName="ProjectName">
                    <syncfusion:GridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock
                                Margin="5 0"
                                hlp:TextBlockHelper.HighlightText="{Binding DataContext.SearchText, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                Text="{Binding ProjectName}" />
                        </DataTemplate>
                    </syncfusion:GridTemplateColumn.CellTemplate>
                </syncfusion:GridTemplateColumn>
                <!--#endregion-->

                <!--#region StartDate -->
                <syncfusion:GridTemplateColumn
                    Width="100"
                    HorizontalAlignment="Center"
                    HorizontalHeaderContentAlignment="Center"
                    HeaderText="{x:Static language:Language.metadataProjectDatagridHeaderStartDateLabel}"
                    MappingName="ProjectStartDateDisplay">
                    <syncfusion:GridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock
                                HorizontalAlignment="Center"
                                hlp:TextBlockHelper.HighlightText="{Binding DataContext.SearchText, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                Text="{Binding ProjectStartDateDisplay}" />
                        </DataTemplate>
                    </syncfusion:GridTemplateColumn.CellTemplate>
                </syncfusion:GridTemplateColumn>
                <!--#endregion-->

                <!--#region EndDate -->
                <syncfusion:GridTemplateColumn
                    Width="100"
                    HorizontalAlignment="Center"
                    HorizontalHeaderContentAlignment="Center"
                    HeaderText="{x:Static language:Language.metadataProjectDatagridHeaderEndDateLabel}"
                    MappingName="ProjectEndDateDisplay">
                    <syncfusion:GridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock
                                HorizontalAlignment="Center"
                                hlp:TextBlockHelper.HighlightText="{Binding DataContext.SearchText, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                Text="{Binding ProjectEndDateDisplay}" />
                        </DataTemplate>
                    </syncfusion:GridTemplateColumn.CellTemplate>
                </syncfusion:GridTemplateColumn>
                <!--#endregion-->

                <!--#region Project closed-->
                <syncfusion:GridCheckBoxColumn
                    Width="80"
                    MappingName="ProjectClosed"
                    HorizontalHeaderContentAlignment="Center"
                    HeaderText="{x:Static language:Language.metadataProjectDatagridHeaderClosedLabel}"
                    AllowEditing="False" HorizontalAlignment="Center"
                    IsThreeState="False" />
                <!--#endregion-->

            </syncfusion:SfDataGrid.Columns>
        </syncfusion:SfDataGrid>
        <!--#endregion-->


    </Grid>
</UserControl>
