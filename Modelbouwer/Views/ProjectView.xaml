<UserControl x:Class="Modelbouwer.Views.ProjectView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:hlp="clr-namespace:Modelbouwer.Helpers"
             xmlns:language="clr-namespace:Modelbouwer.Resources.Languages"
             xmlns:local="clr-namespace:Modelbouwer.Views"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
             xmlns:viewmodels="clr-namespace:Modelbouwer.ViewModels"
             d:DataContext="{d:DesignInstance Type=viewmodels:ProjectPageViewModel}"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch"
             mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="85" />
            <RowDefinition Height="96" />
            <RowDefinition Height="40" />
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
            <RowDefinition Height="25" />
        </Grid.RowDefinitions>

        <!--#region Page header-->
        <StackPanel
            Grid.Row="0"
            VerticalAlignment="Center"
            Background="{DynamicResource HeaderBackground}">
            <StackPanel Orientation="Horizontal" Margin="10,0,0,0">
                <Image
                    Style="{DynamicResource HeaderIconStyle}"
                    Source="{StaticResource Projects}" />
                <TextBlock Style="{DynamicResource HeaderTitle}" Text="{x:Static language:Language.metadataProjectHeaderTitel}" />
            </StackPanel>
            <Canvas>
                <Path Style="{DynamicResource HeadertTitleLine}" />
            </Canvas>
            <TextBlock Style="{DynamicResource HeaderSubTitle}" Text="{x:Static language:Language.metadataProjectHeaderSubtitle}" />
        </StackPanel>
        <!--#endregion-->


    </Grid>
</UserControl>
