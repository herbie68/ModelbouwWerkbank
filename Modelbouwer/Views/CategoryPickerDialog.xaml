<Window
    x:Class="Modelbouwer.Views.CategoryPickerDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:language="clr-namespace:Modelbouwer.Resources.Languages"
    xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
    Title="{x:Static language:Language.metadataProductTabGeneralTabItemProductButtonSearchCategoryLabel}"
    WindowStartupLocation="CenterOwner">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>


        <!--#region Toolbar-->
        <StackPanel Orientation="Horizontal" Grid.Column="0" Margin="10,2,0,2" VerticalAlignment="Center" HorizontalAlignment="Left">
            <Button
                Style="{StaticResource ActionBarButtonStyle}"
                Command="{Binding OkCommand}"
                CommandParameter="{Binding ElementName=CategoryTreeGrid}"
                ToolTip="{x:Static language:Language.toolbarButtonActionSelect}">
                <Image Style="{DynamicResource ToolBarSelectIcon}" />
            </Button>

            <Button
                Style="{StaticResource ActionBarButtonStyle}"
                Command="{Binding CancelCommand}"
                CommandParameter="{Binding ElementName=CategoryTreeGrid}"
                ToolTip="{x:Static language:Language.toolbarButtonActionCancel}">
                <Image Style="{DynamicResource ToolBarCancelIcon}" />
            </Button>

            <Border Style="{StaticResource ActionBarSeparatorStyle}" />

            <Button
                Style="{StaticResource ActionBarButtonStyle}"
                Command="{Binding ExpandAllCommand}"
                CommandParameter="{Binding ElementName=CategoryTreeGrid}"
                ToolTip="{x:Static language:Language.toolbarButtonActionExpand}">
                <Image Style="{DynamicResource ToolBarExpandIcon}" />
            </Button>

            <Button
                Style="{StaticResource ActionBarButtonStyle}"
                Command="{Binding CollapseAllCommand}"
                CommandParameter="{Binding ElementName=CategoryTreeGrid}"
                ToolTip="{x:Static language:Language.toolbarButtonActionCollapse}">
                <Image Style="{DynamicResource ToolBarCollapseIcon}" />
            </Button>
        </StackPanel>

        <!--#region Search field-->
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
            <!--  Icon  -->
            <Image
                x:Name="FilterIcon"
                Width="20"
                Height="20"
                Margin="5"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Source="{StaticResource search}">
                <Image.Triggers>
                    <EventTrigger RoutedEvent="Image.Loaded">
                        <BeginStoryboard>
                            <Storyboard AutoReverse="True" RepeatBehavior="Forever">
                                <DoubleAnimation
                                    Storyboard.TargetProperty="Opacity"
                                    From="1.0"
                                    To="0.3"
                                    Duration="0:0:1" />
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Image.Triggers>
            </Image>

            <!--  Input field  -->
            <TextBox
                Width="250"
                VerticalAlignment="Center"
                Style="{DynamicResource DefaultTextBox}"
                Tag="{x:Static language:Language.SearchTreeTag}"
                Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                ToolTip="{x:Static language:Language.SearchTreeTooltip}" />

            <!--  Clear button  -->
            <Button
                Width="24"
                Height="24"
                Margin="5"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Command="{Binding ClearSearchCommand}"
                Style="{DynamicResource ClearButtonStyle}" />
        </StackPanel>
        <!--#endregion-->

        <!-- Tree -->
        <syncfusion:SfTreeGrid
            x:Name="CategoryTreeGrid"
            Grid.Row="1" Width="500"
            ItemsSource="{Binding CategoryTree}"
            ChildPropertyName="Children" AutoGenerateColumns="False"
            SelectionMode="Single"
            SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
            AutoExpandMode="None">

            <syncfusion:SfTreeGrid.Columns>
                <syncfusion:TreeGridTextColumn
                    MappingName="CategoryName"
                    Width="498"
                    HeaderText="{x:Static language:Language.metadataCategoryDatagridHeaderName}"/>
            </syncfusion:SfTreeGrid.Columns>
        </syncfusion:SfTreeGrid>
    </Grid>
</Window>
