<UserControl x:Class="Modelbouwer.Views.CategoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:hlp="clr-namespace:Modelbouwer.Helpers"
             xmlns:language="clr-namespace:Modelbouwer.Resources.Languages"
             xmlns:local="clr-namespace:Modelbouwer.Views"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
             xmlns:viewmodels="clr-namespace:Modelbouwer.ViewModels"
             d:DataContext="{d:DesignInstance Type=viewmodels:CategoryPageViewModel}"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch"
             mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="85" />
            <RowDefinition Height="96" />
            <RowDefinition Height="40" />
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
            <RowDefinition Height="25" />
        </Grid.RowDefinitions>

        <!--#region Page header-->
        <StackPanel
            Grid.Row="0"
            VerticalAlignment="Center"
            Background="{DynamicResource HeaderBackground}">
            <TextBlock Style="{DynamicResource HeaderTitle}" Text="{x:Static language:Language.metadataCategoryHeaderTitel}" />
            <Canvas>
                <Path Style="{DynamicResource HeadertTitleLine}" />
            </Canvas>
            <TextBlock Style="{DynamicResource HeaderSubTitle}" Text="{x:Static language:Language.metadataCategoryHeaderSubtitle}" />
        </StackPanel>
        <!--#endregion-->

        <!--#region Detail fields-->
        <Grid
            Grid.Row="1"
            HorizontalAlignment="Left"
            VerticalAlignment="Center">

            <Grid.RowDefinitions>
                <RowDefinition Height="32" />
                <RowDefinition Height="32" />
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            
            <!-- Category parent -->
            <Label
                Grid.Row="0"
                Grid.Column="0"
                Content="{x:Static language:Language.metadataCategoryFieldCategoryParentId}"
                Style="{DynamicResource EntryLabel}" />

            <Label
                Grid.Row="0"
                Grid.Column="1"
                Style="{DynamicResource EntrySemicolon}" />
            
            <ComboBox
                Grid.Row="0"
                Grid.Column="2"
                ItemsSource="{Binding AllCategories}"
                SelectedValuePath="Id"
                DisplayMemberPath="Name"
                SelectedValue="{Binding SelectedCategory.ParentId}" />

            <!--  Category name  -->
            <Label
                Grid.Row="1"
                Grid.Column="0"
                Content="{x:Static language:Language.metadataCategoryEntryFieldName}"
                Style="{DynamicResource EntryLabel}" />

            <Label
                Grid.Row="1"
                Grid.Column="1"
                Style="{DynamicResource EntrySemicolon}" />

            <TextBox
                Grid.Row="1"
                Grid.Column="2"
                Width="250"
                Style="{DynamicResource DefaultTextBox}"
                Tag="{x:Static language:Language.metadataCategoryEntryFieldNameTag}"
                Text="{Binding SelectedCategory.CategoryName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                ToolTip="{x:Static language:Language.metadataCategoryEntryFieldNameTooltip}" />
        </Grid>
        <!--#endregion-->

        <!--#region Toolbar section-->
        <Grid Grid.Row="3" 
              Margin="15,2,15,2"  
              VerticalAlignment="Center">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="250" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock 
                   Text="{Binding ImportStatus}" 
                   Foreground="Gray"
                   FontStyle="Italic"
                   Margin="5"
                   Visibility="{Binding IsImporting, Converter={StaticResource BooleanToVisibilityConverter}}" 
                   TextWrapping="Wrap"/>

            <!--#region Toolbar-->
            <StackPanel Orientation="Horizontal" Grid.Column="0" Margin="10,2,0,2">
                <Button
                       Style="{StaticResource ActionBarButtonStyle}"
                       Command="{Binding AddCountryCommand}" 
                       ToolTip="{x:Static language:Language.toolbarButtonActionNew}">
                    <Image Style="{DynamicResource ToolBarAddIcon}" />
                </Button>

                <Button 
               Style="{StaticResource ActionBarButtonStyle}"
                       Command="{Binding DeleteCountryCommand}"
                       ToolTip="{x:Static language:Language.toolbarButtonActionDelete}">
                    <Image Style="{DynamicResource ToolBarDeleteIcon}" />
                </Button>

                <Button 
                       Style="{StaticResource ActionBarButtonStyle}"
                       Command="{Binding SaveCountryCommand}"
                       ToolTip="{x:Static language:Language.toolbarButtonActionSave}">
                    <Image Style="{DynamicResource ToolBarSaveIcon}" />
                </Button>

                <Border Style="{StaticResource ActionBarSeparatorStyle}" />

                <Button 
                       Style="{StaticResource ActionBarButtonStyle}"
                       Click="ButtonImport" 
                       ToolTip="{x:Static language:Language.toolbarButtonActionImport}">
                    <Image Style="{DynamicResource ToolBarImportIcon}" />
                </Button>

                <Button 
                       Style="{StaticResource ActionBarButtonStyle}"
                       Click="ButtonCSVExport"
                       ToolTip="{x:Static language:Language.toolbarButtonActionExportCSV}">
                    <Image Style="{DynamicResource ToolBarCSVExportIcon}" />
                </Button>

                <Button 
                       Style="{StaticResource ActionBarButtonStyle}"
                       Click="ButtonExcelExport" 
                       ToolTip="{x:Static language:Language.toolbarButtonActionExportExcel}">
                    <Image Style="{DynamicResource ToolBarExcelExportIcon}" />
                </Button>
            </StackPanel>
            <!--#endregion-->

            <!--#region Record Count Section -->
            <TextBlock
                   Grid.Column="1"
                   Width="250"
                   Height="23" FontSize="14" FontWeight="Bold"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center">
           
                   <Run Text="{x:Static language:Language.toolbarVisibleRowLabelCategory}" />
                   <Run Text=": " />
                   <Run
                       FontSize="16"
                       Text="{Binding VisibleItemCount, StringFormat={}{0:N0}}"
                       FontStyle="Italic" />
                   <Run Text=" " />
                   <Run Text="{x:Static language:Language.toolbarVisibleRowLabelNumberSeperator}" FontWeight="Normal"/>
                   <Run Text=" " />
                   <Run Text="{Binding TotalCategoryCount, StringFormat={}{0:N0}, Mode=OneWay}" FontSize="16" FontWeight="Bold" FontStyle="Italic"/>
            </TextBlock>
            <!--#endregion-->

            <!--#region Search field-->
            <!--  Icon  -->
            <Image
                   x:Name="FilterIcon"
                   Grid.Column="2"
                   Width="20"
                   Height="20"
                   Margin="5"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Center"
                   Source="{StaticResource search}">
                <Image.Triggers>
                    <EventTrigger RoutedEvent="Image.Loaded">
                        <BeginStoryboard>
                            <Storyboard AutoReverse="True" RepeatBehavior="Forever">
                                <DoubleAnimation
                                       Storyboard.TargetProperty="Opacity"
                                       From="1.0"
                                       To="0.3"
                                       Duration="0:0:1" />
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Image.Triggers>
            </Image>

            <!--  Input field  -->
            <TextBox
                   Grid.Column="3"
                   Width="250"
                   VerticalAlignment="Center"
                   Style="{DynamicResource DefaultTextBox}"
                   Tag="{x:Static language:Language.SearchGridTag}"
                   Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                   ToolTip="{x:Static language:Language.SearchGridTooltip}" />

            <!--  Clear button  -->
            <Button
                   Grid.Column="4"
                   Width="24"
                   Height="24"
                   Margin="5"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Center"
                   Command="{Binding ClearSearchCommand}"
                   Style="{DynamicResource ClearButtonStyle}" />
            <!--#endregion-->
        </Grid>
        <!--#endregion-->

        <!--#region Data grid-->
        <syncfusion:SfTreeGrid
            x:Name="SfGridTree"
            Grid.Row="4"
            Margin="15,3,15,5"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Top"
            AllowSorting="True"
            AllowTriStateSorting="True"
            AutoGenerateColumns="False"
            ColumnSizer="Star"
            ItemsSource="{Binding Categories}"
            ChildPropertyName="Children"
            SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
            AutoExpandMode="RootNodesExpanded">

            <syncfusion:SfTreeGrid.Columns>
                <syncfusion:TreeGridTextColumn
                    MappingName="Name"
                    HeaderText="Category" />
            </syncfusion:SfTreeGrid.Columns>

        </syncfusion:SfTreeGrid>
        <!--#endregion-->

    </Grid>
</UserControl>