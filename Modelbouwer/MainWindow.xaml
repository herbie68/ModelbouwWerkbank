<Window x:Class="Modelbouwer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Modelbouwer"
        xmlns:viewmodels="clr-namespace:Modelbouwer.ViewModels"
        xmlns:views="clr-namespace:Modelbouwer.Views"
        xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
        mc:Ignorable="d"
        Title="Moderlbouwers Werkbank" Height="450" Width="800">

    <Window.DataContext>
        <viewmodels:NavigationViewModel />
    </Window.DataContext>
    
    <Window.Resources>
        <Style x:Key="ItemStyle" TargetType="syncfusion:NavigationItem">
            <Setter Property="Icon" Value="{Binding NavigationIcon}" />
            <Setter Property="DisplayMemberPath" Value="NavigationItem" />
            <Setter Property="ToolTip" Value="{Binding NavigationTooltip}" /> 
            <Setter Property="ItemsSource" Value="{Binding SubItems}" />
            <Setter Property="Command" Value="{Binding Command}" />
            <Setter Property="CommandParameter" Value="{Binding}" />
        </Style>
        
        <DataTemplate DataType="{x:Type views:CountryView}">
            <views:CountryView />
        </DataTemplate>
    </Window.Resources>
    <syncfusion:SfNavigationDrawer
        x:Name="navigationDrawer"
        DisplayMemberPath="NavigationItem"
        DisplayMode="Expanded"
        ItemContainerStyle="{StaticResource ItemStyle}"
        ItemsSource="{Binding NavigationItems}">
        <syncfusion:SfNavigationDrawer.ContentView>
            <ContentControl Content="{Binding CurrentView}" />
        </syncfusion:SfNavigationDrawer.ContentView>
    </syncfusion:SfNavigationDrawer>
</Window>
