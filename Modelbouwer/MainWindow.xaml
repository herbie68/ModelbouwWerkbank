<Window x:Class="Modelbouwer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
        mc:Ignorable="d"
        Title="Modelbouwer Werkbank"
        Height="800"
        Width="1024"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized">

    <Window.Resources>
        <Style x:Key="ItemStyle" TargetType="syncfusion:NavigationItem">
            <Setter Property="Icon" Value="{Binding NavigationIcon}" />
            <Setter Property="DisplayMemberPath" Value="NavigationItem" />
            <Setter Property="ToolTip" Value="{Binding NavigationTooltip}" />
            <Setter Property="ItemsSource" Value="{Binding SubItems}" />
            <Setter Property="Command" Value="{Binding Command}" />
            <Setter Property="CommandParameter" Value="{Binding}" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Navigation -->
            <ColumnDefinition Width="Auto" />

            <!-- Main content -->
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <!-- Content area -->
            <RowDefinition Height="*" />
            <RowDefinition Height="95" />
        </Grid.RowDefinitions>

        <!-- Loading indicator -->
        <TextBlock Grid.ColumnSpan="2"
                   Text="Loading navigation..."
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   FontSize="16"
                   Visibility="{Binding IsNavigationLoaded,
                   Converter={StaticResource InverseBooleanToVisibilityConverter}}" />

        <!-- Navigation drawer -->
        <syncfusion:SfNavigationDrawer
            Grid.Column="0"
            DisplayMode="Expanded"
            DisplayMemberPath="NavigationItem"
            DrawerWidth="260"
            ItemContainerStyle="{StaticResource ItemStyle}"
            ItemsSource="{Binding NavigationItems}"
            Visibility="{Binding IsNavigationLoaded,
            Converter={StaticResource BooleanToVisibilityConverter}}" />

        <!-- Main content host -->
        <Border Grid.Column="1" Grid.RowSpan="2"
                Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}">
            <ContentControl x:Name="ContentHost"
                            Content="{Binding CurrentView}"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch" />
        </Border>

        <Border Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="#f5f5f5">
            <StackPanel Orientation="Vertical">
                <Image Source="{StaticResource DevLogo}" Height="60"/>
                <TextBlock
                    VerticalAlignment="Center" HorizontalAlignment="Center"
                    Margin="5,5" Height="20" FontSize="14" Foreground="#034bac" FontWeight="DemiBold" FontStyle="Italic"
                    Text="{Binding AppVersion}"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
