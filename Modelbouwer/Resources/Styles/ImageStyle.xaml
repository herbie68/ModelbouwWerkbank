<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--#region Image Border-->
    <Style x:Key="ImageBorder" TargetType="Border">
        <Setter Property="BorderBrush">
            <Setter.Value>
                <LinearGradientBrush MappingMode="Absolute"
                                     SpreadMethod="Reflect"
                                     StartPoint="0.5,0"
                                     EndPoint="0.5,1">
                    <GradientStop Offset="0.0" Color="#FF293475" />
                    <GradientStop Offset="0.5" Color="#FF9BA3D7" />
                    <GradientStop Offset="1.0" Color="#FFB4BCED" />
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>

        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="CornerRadius" Value="3"/>
    </Style>
    <!--#endregion-->

    <!--#region Project Image -->
    <Style x:Key="ProjectImage" TargetType="Image">
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!--#endregion-->

    <!--#region Product Image -->
    <Style x:Key="ProductImage" TargetType="Image">
        <Setter Property="Height" Value="230" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Width" Value="230" />
    </Style>
    <!--#endregion-->

    <!--#region Small product Image -->
    <Style x:Key="ProductImageSmall" TargetType="Image">
        <Setter Property="Height" Value="96" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Width" Value="96" />
    </Style>
    <!--#endregion-->

    <!--#region Image toolbar -->
    <Style x:Key="ImageToolBarButtonStyle" TargetType="Button">
        <Setter Property="Height" Value="20" />
        <Setter Property="Width" Value="20" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="0 0 0 0"/>
        <Setter Property="Padding" Value="0 2.5 0 2.5"/>
    </Style>

    <Style x:Key="ImageToolBarSeparatorStyle" TargetType="Border">
        <Setter Property="Width" Value="1" />
        <Setter Property="Height" Value="15" />
        <Setter Property="Margin" Value="8,0" />
        <Setter Property="Background" Value="#66000000" />
    </Style>
    <!--#endregion-->

    <!--#region Header group resources-->
    <Style x:Key="ImageHeaderGroup" TargetType="Image">
        <Setter Property="Height" Value="14" />
        <Setter Property="Margin" Value="3" />
    </Style>
    <!--#endregion-->

    <!--#region Goto Web Icon-->
    <Style x:Key="GotoWebIcon" TargetType="Image">
        <Setter Property="Source" Value="{StaticResource gotoweb}" />
    </Style>
    <!--#endregion-->
</ResourceDictionary>