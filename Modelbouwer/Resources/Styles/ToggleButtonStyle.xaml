<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:language="clr-namespace:Modelbouwer.Resources.Languages">

    <SolidColorBrush x:Key="SwitchButton.Border.Color" Color="Transparent" />
    <SolidColorBrush x:Key="SwitchButton.Background.Color" Color="Transparent" />
    <SolidColorBrush x:Key="TextBox.Green.Background.Color" Color="#69DB0E" />
    <SolidColorBrush x:Key="TextBox.Green.Borderbrush.Color" Color="#397607" />
    <SolidColorBrush x:Key="TextBox.Green.Foreground.Color" Color="White" />
    <SolidColorBrush x:Key="TextBox.Red.Background.Color" Color="#DB210E" /> 
    <SolidColorBrush x:Key="TextBox.Red.Borderbrush.Color" Color="#761107" />
    <SolidColorBrush x:Key="TextBox.Red.Foreground.Color" Color="#F7EF80" />
    
    <Style x:Key="SwitchButton" TargetType="{x:Type ToggleButton}">
        <Setter Property="Background" Value="{StaticResource SwitchButton.Background.Color}" />
        <Setter Property="BorderBrush" Value="{StaticResource SwitchButton.Border.Color}" />
        <Setter Property="Padding" Value="1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border
                        x:Name="border"
                        Background="{TemplateBinding Background}"
                        BorderBrush="Transparent"
                        BorderThickness="0"
                        >
                        <Grid
                            Width="70"
                            Height="20"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            >
                            <TextBox
                                x:Name="SwitchText"
                                Width="60"
                                Height="14"
                                Margin="13,0,0,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                HorizontalContentAlignment="Right"
                                Background="{StaticResource TextBox.Green.Background.Color}"
                                BorderBrush="{StaticResource TextBox.Green.Borderbrush.Color}"
                                FontSize="8"
                                FontWeight="Bold"
                                IsReadOnly="True"
                                Style="{DynamicResource DisabledTextBox}"
                                Text="{x:Static language:Language.ProjectEntryNotCompletedTag}"
                                ToolTip="{x:Static language:Language.ProjectEntryNotCompletedTooltip}"
                                />
                            <Image
                                x:Name="Switch1"
                                Width="20"
                                Height="20"
                                Margin="0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                RenderTransformOrigin="0.5,0.5"
                                Source="{StaticResource ToggleGreen}"
                                Stretch="Uniform"
                                ToolTip="{x:Static language:Language.ProjectEntryNotCompletedTooltip}"
                                />

                            <Image
                                x:Name="Switch2"
                                Width="20"
                                Height="20"
                                Margin="0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                RenderTransformOrigin="0.5,0.5"
                                Source="{StaticResource ToggleRed}"
                                Stretch="Uniform"
                                ToolTip="{x:Static language:Language.ProjectEntryCompletedTooltip}"
                                Visibility="Collapsed"
                                />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Control.Visibility" Value="Hidden" />
                        </Trigger>

                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Switch1" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Switch2" Property="Visibility" Value="Visible" />
                            <Setter TargetName="SwitchText" Property="Background" Value="{StaticResource TextBox.Red.Background.Color}" />
                            <Setter TargetName="SwitchText" Property="BorderBrush" Value="{StaticResource TextBox.Red.Borderbrush.Color}" />
                            <Setter TargetName="SwitchText" Property="Foreground" Value="{StaticResource TextBox.Red.Foreground.Color}" />
                            <Setter TargetName="SwitchText" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="SwitchText" Property="HorizontalContentAlignment" Value="Left" />
                            <Setter TargetName="SwitchText" Property="Margin" Value="0,0,13,0" />
                            <Setter TargetName="SwitchText" Property="Text" Value="{x:Static language:Language.ProjectEntryStatus}" />
                            <Setter TargetName="SwitchText" Property="Text" Value="{x:Static language:Language.ProjectEntryCompletedTag}" />
                            <Setter TargetName="SwitchText" Property="ToolTip" Value="{x:Static language:Language.ProjectEntryCompletedTooltip}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="SwitchAnimation">
                                    <Storyboard>
                                        <DoubleAnimation
                                            AutoReverse="False"
                                            RepeatBehavior="Forever"
                                            Storyboard.TargetName="Switch1"
                                            Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                            From="0"
                                            To="360"
                                            Duration="0:0:3"
                                            />
                                        <DoubleAnimation
                                            AutoReverse="False"
                                            RepeatBehavior="Forever"
                                            Storyboard.TargetName="Switch2"
                                            Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                            From="0"
                                            To="-360"
                                            Duration="0:0:3"
                                            />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="SwitchAnimation" />
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


